{
  "Astro Blog Post Template": {
    "scope": "markdown",
    "prefix": "newpost",
    "body": [
      "---",
      "title: \"$1\"",
      "description: \"$2\"",
      "date: \"$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE\"",
      "category: \"sights\"",
      "location: \"$3\"",
      "image: \"/images/posts/$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE-$4/header.webp\"",
      "mood: [\"observant\"]",
      "isDraft: false",
      "---",
      "",
      "<div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 items-center\">",
      "  <div class=\"flex flex-col justify-center space-y-3\">",
      "    <p>$5</p>",
      "  </div>",
      "  <div class=\"aspect-[3/4] w-full overflow-hidden rounded-xl border border-neutral-200 shadow-sm dark:border-neutral-800\">",
      "    <img src=\"/images/posts/$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE-$4/image-1.webp\" alt=\"$6\" class=\"w-full h-full object-cover\" />",
      "  </div>",
      "</div>",
      "",
      "<div class=\"mb-8 space-y-3\">",
      "  <p>$7</p>",
      "</div>",
      "",
      "<script type=\"application/ld+json\">",
      "{",
      "  \"@context\": \"https://schema.org\",",
      "  \"@type\": \"BlogPosting\",",
      "  \"headline\": \"$1\",",
      "  \"description\": \"$2\",",
      "  \"datePublished\": \"$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE\",",
      "  \"image\": \"https://darlalovly.com/images/posts/$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE-$4/header.webp\",",
      "  \"author\": {",
      "    \"@type\": \"Person\",",
      "    \"name\": \"Darla\"",
      "  },",
      "  \"contentLocation\": {",
      "    \"@type\": \"Place\",",
      "    \"name\": \"$3\",",
      "    \"address\": {",
      "      \"@type\": \"PostalAddress\",",
      "      \"addressLocality\": \"$8\",",
      "      \"addressRegion\": \"$9\",",
      "      \"addressCountry\": \"US\"",
      "    }",
      "  }",
      "}",
      "</script>"
    ],
    "description": "Insert standard SEO & schema post template"
  }
}