---
// File: src/pages/posts/[slug].astro

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const cloudflareBase = import.meta.env.PUBLIC_R2_URL || "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/";

const isVideoUrl = (url?: string): boolean => {
  if (!url) return false;
  return /\.(mp4|webm|mov|m4v|ogg)(\?.*)?$/i.test(url);
};

const normalizeSlug = (val: string): string => {
  if (!val) return '';
  return val.replace(/\.(md|mdx)$/, '').split('/').pop() || val;
};

const resolveMediaUrl = (media: any, targetSlug = slug): string | undefined => {
  if (!media) return undefined;
  if (typeof media === 'string') {
    const clean = media.trim();
    if (clean.startsWith('http://') || clean.startsWith('https://')) {
      return clean;
    }
    const cleanBase = cloudflareBase.endsWith('/') ? cloudflareBase : `${cloudflareBase}/`;
    const cleanPath = clean.replace(/^\/+/, '');
    if (cleanPath.startsWith('images/')) {
      return `${cleanBase}${cleanPath}`;
    }
    return `${cleanBase}images/posts/${targetSlug}/${cleanPath}`;
  }
  if (typeof media === 'object' && media?.src) {
    return media.src;
  }
  return undefined;
};

const detectOrientation = (data: any): 'portrait' | 'landscape' | 'square' => {
  const raw = String(
    data?.heroOrientation ||
    data?.orientation ||
    data?.imageOrientation ||
    data?.videoOrientation ||
    data?.aspectRatio ||
    data?.aspect ||
    ''
  ).toLowerCase();
  if (
    raw.includes('portrait') ||
    raw.includes('vertical') ||
    raw.includes('9/16') ||
    raw.includes('9:16') ||
    raw.includes('9x12') ||
    raw.includes('3/4') ||
    raw.includes('3:4')
  ) {
    return 'portrait';
  }
  if (raw.includes('square') || raw.includes('1/1') || raw.includes('1:1')) {
    return 'square';
  }
  return 'landscape';
};

const allPosts = await getCollection('posts');
const publishedPosts = allPosts
  .filter((p) => !p.data.isDraft && !p.data.draft)
  .sort((a, b) => new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf());

const getSlug = (p: CollectionEntry<'posts'>) => (p as any).slug || p.id.replace(/\.(md|mdx)$/, '');

const post = publishedPosts.find((p) => normalizeSlug(getSlug(p)) === normalizeSlug(slug));

if (!post) {
  return Astro.redirect('/404');
}

const currentIndex = publishedPosts.findIndex((p) => normalizeSlug(getSlug(p)) === normalizeSlug(getSlug(post)));

if (currentIndex === -1) {
  return Astro.redirect('/404');
}

const prevPost = currentIndex > 0 ? publishedPosts[currentIndex - 1] : null;
const nextPost = currentIndex < publishedPosts.length - 1 ? publishedPosts[currentIndex + 1] : null;

const prevSlug = prevPost ? getSlug(prevPost) : null;
const prevTitle = prevPost ? prevPost.data.title : null;
const prevImage = prevPost ? resolveMediaUrl(prevPost.data.thumbnailKey || (prevPost.data as any).image, prevSlug) : null;
const prevOrientation = prevPost ? detectOrientation(prevPost.data) : 'landscape';

const nextSlug = nextPost ? getSlug(nextPost) : null;
const nextTitle = nextPost ? nextPost.data.title : null;
const nextImage = nextPost ? resolveMediaUrl(nextPost.data.thumbnailKey || (nextPost.data as any).image, nextSlug) : null;
const nextOrientation = nextPost ? detectOrientation(nextPost.data) : 'landscape';

const rawVideo = (post.data as any).video || (post.data as any).heroVideo || (post.data as any).videoUrl;
const rawImage = post.data.thumbnailKey || (post.data as any).image || (post.data as any).heroImage;

let heroVideo = resolveMediaUrl(rawVideo, slug);
let heroImage = resolveMediaUrl(rawImage, slug);

if (!heroVideo && isVideoUrl(heroImage)) {
  heroVideo = heroImage;
  heroImage = resolveMediaUrl((post.data as any).poster || (post.data as any).coverImage, slug);
}

const heroOrientation = detectOrientation(post.data);
const heroPosition = (post.data as any).heroPosition || (
  (post.data as any).showHeroImage === false || (post.data as any).showHero === false ? 'none' : 'top'
);
const showHero = heroPosition !== 'none' && (post.data as any).showHeroImage !== false && (post.data as any).showHero !== false;

const locations = (post.data as any).locations || (post.data as any).pins || [];
const galleryItems = post.data.gallery || [];

const { Content } = typeof (post as any).render === 'function' ? await (post as any).render() : await render(post);
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url);

const formatDate = (dateVal: string | Date) => {
  if (!dateVal) return '';
  const d = dateVal instanceof Date ? dateVal : new Date(dateVal);
  if (isNaN(d.getTime())) return String(dateVal);
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
};

const formattedDate = formatDate(post.data.date);

const locationSchemas = locations.map((loc: any) => {
  const lat = loc.lat ?? loc.latitude;
  const lng = loc.lng ?? loc.longitude ?? loc.lon;
  return {
    "@type": "Place",
    "name": loc.name || loc.title || loc.label || post.data.location || "Waypoint",
    ...(loc.address ? {
      "address": {
        "@type": "PostalAddress",
        "streetAddress": loc.address
      }
    } : {}),
    ...(lat && lng ? {
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": Number(lat),
        "longitude": Number(lng)
      }
    } : {})
  };
});

const schemaGraph: any = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${canonicalURL}#post`,
      "headline": post.data.title,
      "description": post.data.description ?? post.data.excerpt ?? "",
      "datePublished": new Date(post.data.date).toISOString(),
      "dateModified": (post.data as any).modifiedDate ? new Date((post.data as any).modifiedDate).toISOString() : new Date(post.data.date).toISOString(),
      "author": {
        "@type": "Person",
        "name": "Darla",
        "url": "https://darlalovly.com/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": "darlalovly",
        "logo": {
          "@type": "ImageObject",
          "url": `${cloudflareBase.replace(/\/$/, '')}/branding/darlalovly-logo.webp`
        }
      },
      ...(heroImage ? { "image": [new URL(heroImage, canonicalURL).href] } : {}),
      ...(locationSchemas.length > 0 ? {
        "contentLocation": locationSchemas.length === 1 ? locationSchemas[0] : locationSchemas
      } : (post.data.location ? {
        "contentLocation": {
          "@type": "Place",
          "name": post.data.location,
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Shreveport",
            "addressRegion": "LA",
            "addressCountry": "US"
          }
        }
      } : {}))
    }
  ]
};
---

<BaseLayout 
  title={`${post.data.title} — darlalovly`}
  description={post.data.description ?? post.data.excerpt ?? ''}
  image={heroImage}
  canonicalURL={canonicalURL}
  type="article"
  publishedTime={post.data.date}
  noindex={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} is:inline />

  <div id="crt-static-overlay" class="fixed inset-0 pointer-events-none z-[100] opacity-0 bg-neutral-950 flex items-center justify-center overflow-hidden" aria-hidden="true">
    <div class="tv-noise-layer absolute inset-0 pointer-events-none"></div>
    <div class="tv-horizontal-bar absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-tear-slice tv-tear-1 absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-tear-slice tv-tear-2 absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-vhold-blanking-bar absolute inset-x-0 h-16 pointer-events-none"></div>
    <div class="tv-interlace-odd absolute inset-0 pointer-events-none"></div>
    <div class="tv-interlace-even absolute inset-0 pointer-events-none"></div>
    <div class="tv-hsync-band tv-hsync-upper absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-hsync-band tv-hsync-lower absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-scanlines absolute inset-0 pointer-events-none"></div>
  </div>

  <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center pb-16 overflow-x-clip">
    <article class="flex flex-col w-full items-center">
      <header class="mb-10 sm:mb-14 flex flex-col items-center justify-center text-center space-y-4 sm:space-y-5 w-full">
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 font-mono text-[11px] sm:text-xs uppercase tracking-[0.2em] sm:tracking-[0.25em] text-neutral-400">
          <time datetime={new Date(post.data.date).toISOString()}>
            {formattedDate}
          </time>
          {post.data.location && (
            <>
              <span class="text-neutral-600">•</span>
              <span class="text-neutral-300">{post.data.location}</span>
            </>
          )}
        </div>

        <div class="relative w-full py-2 flex justify-center items-center select-none overflow-hidden">
          <h1 
            class="glitch-title font-sans font-normal text-white text-center break-words m-0"
            data-text={post.data.title}
          >
            {post.data.title}
          </h1>
        </div>
      </header>

      {/* Top Center Hero Media */}
      {showHero && (heroVideo || heroImage) && heroPosition === 'top' && (
        <div class="mb-10 sm:mb-14 w-full flex justify-center items-center">
          <div class:list={[
            "relative max-w-full select-none flex items-center justify-center bg-transparent border-0 shadow-none",
            heroOrientation === 'portrait' ? 'max-w-md w-full' : '',
            heroOrientation === 'square' ? 'max-w-xl w-full' : '',
            heroOrientation === 'landscape' ? 'w-full' : ''
          ]}>
            {heroVideo ? (
              <video
                src={heroVideo}
                poster={heroImage && !isVideoUrl(heroImage) ? heroImage : undefined}
                controls
                playsinline
                preload="metadata"
                data-orientation={heroOrientation}
                class:list={[
                  "block mx-auto rounded-xl border-0 shadow-none outline-none bg-transparent post-hero-video",
                  heroOrientation === 'portrait' ? 'w-auto h-auto max-h-[85vh] aspect-[9/16] object-contain' : '',
                  heroOrientation === 'square' ? 'w-auto h-auto max-h-[85vh] aspect-square object-contain' : '',
                  heroOrientation === 'landscape' ? 'w-full h-auto max-h-[85vh] object-contain' : ''
                ]}
              >
                <source src={heroVideo} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            ) : (
              <img 
                src={heroImage} 
                alt={post.data.title} 
                loading="eager"
                decoding="async"
                class:list={[
                  "block mx-auto rounded-xl border-0 shadow-none outline-none bg-transparent",
                  heroOrientation === 'portrait' ? 'w-auto h-auto max-w-full max-h-[85vh] object-contain' : '',
                  heroOrientation === 'square' ? 'w-auto h-auto max-w-full max-h-[85vh] object-contain' : '',
                  heroOrientation === 'landscape' ? 'w-auto h-auto max-w-full max-h-[85vh] object-contain' : ''
                ]}
              />
            )}
          </div>
        </div>
      )}

      <!-- Clean Narrative Text with Float Wrap and Direct R2 Media Upgrades -->
      <div class="prose prose-invert prose-neutral max-w-none font-sans text-neutral-200 leading-relaxed pt-2 break-words w-full text-left">
        {/* Left or Right Floating Hero Media */}
        {showHero && (heroVideo || heroImage) && (heroPosition === 'left' || heroPosition === 'right') && (
          <div class:list={[
            "hero-media-wrap select-none not-prose",
            heroPosition === 'left' ? 'media-wrap-left' : 'media-wrap-right'
          ]}>
            {heroVideo ? (
              <video
                src={heroVideo}
                poster={heroImage && !isVideoUrl(heroImage) ? heroImage : undefined}
                controls
                playsinline
                preload="metadata"
                data-orientation={heroOrientation}
                class="block w-full h-auto rounded-xl border-0 shadow-none outline-none bg-transparent"
              >
                <source src={heroVideo} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            ) : (
              <img 
                src={heroImage} 
                alt={post.data.title} 
                loading="eager"
                decoding="async"
                class="block w-full h-auto max-h-[75vh] object-contain rounded-xl border-0 shadow-none outline-none bg-transparent"
              />
            )}
          </div>
        )}

        <Content />
      </div>

      {locations.length > 0 && (
        <section class="mt-12 pt-8 border-t border-neutral-800/80 flex flex-col gap-4 font-mono w-full clear-both text-left" aria-label="Locations">
          <div class="flex items-center justify-between text-xs text-neutral-400 uppercase tracking-[0.2em]">
            <span>[ Location Pins & Links ]</span>
            <span>{locations.length} {locations.length === 1 ? 'Pin' : 'Pins'}</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {locations.map((loc: any) => {
              const lat = loc.lat ?? loc.latitude;
              const lng = loc.lng ?? loc.longitude ?? loc.lon;
              const mapsUrl = loc.url || loc.mapUrl || (lat && lng ? `https://www.google.com/maps/search/?api=1&query=${lat},${lng}` : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${loc.name || loc.title || ''} ${loc.address || ''}`)}`);
              return (
                <a
                  href={mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-start gap-3 p-3.5 rounded-xl bg-neutral-900/60 border border-neutral-800 hover:border-neutral-600 transition-colors group select-none text-left"
                >
                  <span class="text-base select-none">📍</span>
                  <div class="flex flex-col min-w-0">
                    <span class="text-white group-hover:underline font-sans text-sm font-medium truncate">
                      {loc.name || loc.title || loc.label}
                    </span>
                    {loc.address && (
                      <span class="text-neutral-400 font-mono text-[11px] mt-0.5 break-words">
                        {loc.address}
                      </span>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {galleryItems.length > 0 && (
        <section class="my-12 pt-8 border-t border-neutral-800/80 clear-both w-full select-none text-left" aria-label="Photo Archive">
          <div class="mb-6 flex items-center justify-between font-mono text-xs text-neutral-400 uppercase tracking-[0.2em]">
            <span>[ Photo Archive ]</span>
            <span>{galleryItems.length} {galleryItems.length === 1 ? 'Image' : 'Images'}</span>
          </div>
          <div class="columns-1 sm:columns-2 md:columns-3 gap-4 space-y-4">
            {galleryItems.map((item: any) => {
              const itemKey = typeof item === 'string' ? item : (item.src || item.key);
              const itemSrc = resolveMediaUrl(itemKey, slug);
              const altText = typeof item === 'object' ? (item.alt || item.caption || '') : '';

              return (
                <figure class="break-inside-avoid relative overflow-hidden rounded-xl bg-neutral-900 border border-neutral-800 mb-4">
                  <img
                    src={itemSrc}
                    alt={altText || post.data.title}
                    loading="lazy"
                    decoding="async"
                    class="block w-full h-auto object-contain rounded-xl"
                  />
                  {altText && (
                    <figcaption class="p-3 text-[11px] font-mono text-neutral-400 bg-neutral-950/90 border-t border-neutral-800/80 text-center leading-snug">
                      {altText}
                    </figcaption>
                  )}
                </figure>
              );
            })}
          </div>
        </section>
      )}

      <nav class="mt-16 sm:mt-24 pt-8 sm:pt-12 border-t border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-8 w-full select-none clear-both" aria-label="Post pagination">
        <div class="w-full sm:flex-1 flex justify-start min-w-0">
          {nextSlug && (
            <div class="relative group flex items-center w-full sm:w-auto">
              {nextImage && (
                <div class="absolute bottom-full mb-4 left-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-30">
                  <div class:list={[
                    "crt-tv-frame rounded-xl bg-neutral-950 border border-neutral-700/60 shadow-2xl relative overflow-hidden flex items-center justify-center p-0.5",
                    nextOrientation === 'portrait' ? 'crt-portrait' : nextOrientation === 'square' ? 'crt-square' : 'crt-landscape'
                  ]}>
                    <div class="absolute inset-0 pointer-events-none z-20 crt-screen-vignette"></div>
                    <div class="absolute inset-0 pointer-events-none z-10 crt-scanlines"></div>
                    <img
                      src={nextImage}
                      alt={nextTitle || 'Next post'}
                      loading="lazy"
                      class="crt-thumb-img rounded-xl block w-auto h-auto max-w-full max-h-full object-contain"
                    />
                  </div>
                </div>
              )}
              <a
                href={`/posts/${nextSlug}`}
                class="post-nav-link flex items-center gap-3 sm:gap-4 text-left transition-colors cursor-pointer max-w-full sm:max-w-sm py-2 active:opacity-70 group"
                rel="next"
              >
                <span class="text-3xl sm:text-5xl md:text-6xl font-mono text-white leading-none select-none transition-all duration-300 ease-out group-hover:-translate-x-1 sm:group-hover:-translate-x-2 group-hover:scale-110 sm:group-hover:scale-125 group-hover:drop-shadow-[0_0_10px_rgba(255,255,255,0.85)] flex-shrink-0">
                  &lt;
                </span>
                <span class="font-sans text-xs sm:text-sm font-normal uppercase tracking-wider text-neutral-300 group-hover:text-white transition-colors line-clamp-2">
                  {nextTitle}
                </span>
              </a>
            </div>
          )}
        </div>

        <div class="w-full sm:flex-1 flex justify-end min-w-0">
          {prevSlug && (
            <div class="relative group flex items-center justify-end w-full sm:w-auto ml-auto">
              {prevImage && (
                <div class="absolute bottom-full mb-4 right-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-30">
                  <div class:list={[
                    "crt-tv-frame rounded-xl bg-neutral-950 border border-neutral-700/60 shadow-2xl relative overflow-hidden flex items-center justify-center p-0.5",
                    prevOrientation === 'portrait' ? 'crt-portrait' : prevOrientation === 'square' ? 'crt-square' : 'crt-landscape'
                  ]}>
                    <div class="absolute inset-0 pointer-events-none z-20 crt-screen-vignette"></div>
                    <div class="absolute inset-0 pointer-events-none z-10 crt-scanlines"></div>
                    <img
                      src={prevImage}
                      alt={prevTitle || 'Previous post'}
                      loading="lazy"
                      class="crt-thumb-img rounded-xl block w-auto h-auto max-w-full max-h-full object-contain"
                    />
                  </div>
                </div>
              )}
              <a
                href={`/posts/${prevSlug}`}
                class="post-nav-link flex items-center justify-end text-right gap-3 sm:gap-4 transition-colors cursor-pointer max-w-full sm:max-w-sm py-2 active:opacity-70 group"
                rel="prev"
              >
                <span class="font-sans text-xs sm:text-sm font-normal uppercase tracking-wider text-neutral-300 group-hover:text-white transition-colors line-clamp-2">
                  {prevTitle}
                </span>
                <span class="text-3xl sm:text-5xl md:text-6xl font-mono text-white leading-none select-none transition-all duration-300 ease-out group-hover:translate-x-1 sm:group-hover:translate-x-2 group-hover:scale-110 sm:group-hover:scale-125 group-hover:drop-shadow-[0_0_10px_rgba(255,255,255,0.85)] flex-shrink-0">
                  &gt;
                </span>
              </a>
            </div>
          )}
        </div>
      </nav>
    </article>
  </div>
</BaseLayout>

<script>
  import { navigate } from 'astro:transitions/client';

  const R2_PUBLIC_BASE = 'https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/';

  function upgradeProseMedia() {
    const proseImgs = document.querySelectorAll<HTMLImageElement>('.prose img');
    proseImgs.forEach((img) => {
      const src = img.getAttribute('src') || '';
      if (!src) return;

      if (/\.(mp4|webm|mov|m4v)(\?.*)?$/i.test(src)) {
        const video = document.createElement('video');
        video.src = src.startsWith('http') ? src : `${R2_PUBLIC_BASE}${src.replace(/^\/+/, '')}`;
        video.controls = true;
        video.playsInline = true;
        video.preload = 'metadata';
        video.className = img.className || 'w-full h-auto rounded-xl';
        img.parentNode?.replaceChild(video, img);
        return;
      }

      if (!src.startsWith('http://') && !src.startsWith('https://')) {
        const cleanPath = src.replace(/^\/+/, '');
        img.src = `${R2_PUBLIC_BASE}${cleanPath}`;
      }
    });
  }

  const TRANSITION_MODES = [
    { name: 'mode-antenna-gust', delay: 280 },
    { name: 'mode-static-dissolve', delay: 280 },
    { name: 'mode-frame-tear', delay: 180 },
    { name: 'mode-vhold-slip', delay: 180 },
    { name: 'mode-interlace-jitter', delay: 190 },
    { name: 'mode-hsync-shift', delay: 180 }
  ];

  const STORAGE_KEY = 'darlalovly_last_transition_mode';

  function getNextNonRepeatingEffect() {
    try {
      const lastMode = sessionStorage.getItem(STORAGE_KEY);
      const candidatePool = TRANSITION_MODES.filter((mode) => mode.name !== lastMode);
      const chosenEffect = candidatePool[Math.floor(Math.random() * candidatePool.length)] || TRANSITION_MODES[0];
      sessionStorage.setItem(STORAGE_KEY, chosenEffect.name);
      return chosenEffect;
    } catch {
      return TRANSITION_MODES[Math.floor(Math.random() * TRANSITION_MODES.length)];
    }
  }

  function initPostEngine() {
    upgradeProseMedia();

    const staticOverlay = document.getElementById('crt-static-overlay');
    if (staticOverlay) {
      staticOverlay.className = 'fixed inset-0 pointer-events-none z-[100] opacity-0 bg-neutral-950 flex items-center justify-center overflow-hidden';
    }

    const navLinks = document.querySelectorAll('.post-nav-link');
    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetHref = link.getAttribute('href');
        if (!targetHref) return;

        const selectedEffect = getNextNonRepeatingEffect();

        if (staticOverlay) {
          staticOverlay.className = `fixed inset-0 pointer-events-none z-[100] bg-neutral-950 flex items-center justify-center overflow-hidden is-active ${selectedEffect.name}`;
        }

        setTimeout(() => {
          navigate(targetHref);
        }, selectedEffect.delay);
      });
    });

    document.querySelectorAll<HTMLImageElement>('.crt-thumb-img').forEach((img) => {
      const applyFrameOrientation = () => {
        const frame = img.closest<HTMLElement>('.crt-tv-frame');
        if (!frame || !img.naturalWidth || !img.naturalHeight) return;
        const ratio = img.naturalHeight / img.naturalWidth;
        if (ratio > 1.15) {
          frame.classList.add('crt-portrait');
          frame.classList.remove('crt-landscape', 'crt-square');
        } else if (ratio >= 0.88 && ratio <= 1.15) {
          frame.classList.add('crt-square');
          frame.classList.remove('crt-landscape', 'crt-portrait');
        } else {
          frame.classList.add('crt-landscape');
          frame.classList.remove('crt-portrait', 'crt-square');
        }
      };

      if (img.complete && img.naturalWidth > 0) {
        applyFrameOrientation();
      } else {
        img.addEventListener('load', applyFrameOrientation);
      }
    });

    const videos = document.querySelectorAll<HTMLVideoElement>('video');
    videos.forEach((video) => {
      const applyOrientation = () => {
        if (video.videoHeight && video.videoWidth) {
          if (video.videoHeight > video.videoWidth) {
            video.dataset.orientation = 'portrait';
            video.classList.add('portrait');
            video.classList.remove('landscape');
          } else if (video.videoHeight === video.videoWidth) {
            video.dataset.orientation = 'square';
            video.classList.add('square');
          } else {
            video.dataset.orientation = 'landscape';
            video.classList.add('landscape');
            video.classList.remove('portrait');
          }
        }
      };

      if (video.readyState >= 1) {
        applyOrientation();
      } else {
        video.addEventListener('loadedmetadata', applyOrientation);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', upgradeProseMedia);
  document.addEventListener('astro:page-load', initPostEngine);
</script>

