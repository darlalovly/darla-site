---
// File: src/pages/posts/[slug].astro

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

interface Props {
  entry: CollectionEntry<'posts'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => !post.data.isDraft && !post.data.draft)
    .map((entry) => ({
      params: { slug: (entry as any).slug || entry.id.replace(/\.(md|mdx)$/, '') },
      props: { entry },
    }));
}

const { slug } = Astro.params;
const { entry: propEntry } = Astro.props;

const cloudflareBase = import.meta.env.PUBLIC_R2_URL || "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/";

const resolveImageUrl = (img: any): string | undefined => {
  if (!img) return undefined;
  if (typeof img === 'string') {
    if (img.startsWith('http://') || img.startsWith('https://') || img.startsWith('/')) {
      return img;
    }
    const cleanBase = cloudflareBase.endsWith('/') ? cloudflareBase : `${cloudflareBase}/`;
    return `${cleanBase}${img.replace(/^\/+/, '')}`;
  }
  if (typeof img === 'object' && img?.src) {
    return img.src;
  }
  return undefined;
};

const allPosts = await getCollection('posts');
const publishedPosts = allPosts
  .filter((p) => !p.data.isDraft && !p.data.draft)
  .sort((a, b) => new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf());

const getSlug = (p: CollectionEntry<'posts'>) => (p as any).slug || p.id.replace(/\.(md|mdx)$/, '');

const post = propEntry ?? publishedPosts.find((p) => getSlug(p) === slug);

if (!post) {
  return Astro.redirect('/404');
}

const currentIndex = publishedPosts.findIndex((p) => getSlug(p) === getSlug(post));

if (currentIndex === -1) {
  return Astro.redirect('/404');
}

const prevPost = currentIndex > 0 ? publishedPosts[currentIndex - 1] : null;
const nextPost = currentIndex < publishedPosts.length - 1 ? publishedPosts[currentIndex + 1] : null;

const heroImage = resolveImageUrl(post.data.thumbnailKey || (post.data as any).image || (post.data as any).heroImage);

const prevSlug = prevPost ? getSlug(prevPost) : null;
const prevTitle = prevPost ? prevPost.data.title : null;
const prevImage = prevPost ? resolveImageUrl(prevPost.data.thumbnailKey || (prevPost.data as any).image) : null;

const nextSlug = nextPost ? getSlug(nextPost) : null;
const nextTitle = nextPost ? nextPost.data.title : null;
const nextImage = nextPost ? resolveImageUrl(nextPost.data.thumbnailKey || (nextPost.data as any).image) : null;

const locations = (post.data as any).locations || (post.data as any).pins || [];
const galleryItems = post.data.gallery || [];

const { Content } = await render(post);
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url);

const formatDate = (dateVal: string | Date) => {
  if (!dateVal) return '';
  const d = dateVal instanceof Date ? dateVal : new Date(dateVal);
  if (isNaN(d.getTime())) return String(dateVal);
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
};

const formattedDate = formatDate(post.data.date);

const locationSchemas = locations.map((loc: any) => {
  const lat = loc.lat ?? loc.latitude;
  const lng = loc.lng ?? loc.longitude ?? loc.lon;
  return {
    "@type": "Place",
    "name": loc.name || loc.title || loc.label || post.data.location || "Waypoint",
    ...(loc.address ? {
      "address": {
        "@type": "PostalAddress",
        "streetAddress": loc.address
      }
    } : {}),
    ...(lat && lng ? {
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": Number(lat),
        "longitude": Number(lng)
      }
    } : {}),
    ...(loc.url || (lat && lng ? `https://www.google.com/maps/search/?api=1&query=${lat},${lng}` : undefined) ? {
      "hasMap": loc.url || `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`
    } : {})
  };
});

const schemaGraph: any = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${canonicalURL}#post`,
      "headline": post.data.title,
      "description": post.data.description ?? post.data.excerpt ?? "",
      "datePublished": new Date(post.data.date).toISOString(),
      "dateModified": (post.data as any).modifiedDate ? new Date((post.data as any).modifiedDate).toISOString() : new Date(post.data.date).toISOString(),
      "author": {
        "@type": "Person",
        "name": "Darla",
        "url": "https://darlalovly.com/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": "darlalovly",
        "logo": {
          "@type": "ImageObject",
          "url": `${cloudflareBase.replace(/\/$/, '')}/branding/darlalovly-logo.webp`
        }
      },
      ...(heroImage ? { "image": [new URL(heroImage, canonicalURL).href] } : {}),
      ...(locationSchemas.length > 0 ? {
        "contentLocation": locationSchemas.length === 1 ? locationSchemas[0] : locationSchemas
      } : (post.data.location ? {
        "contentLocation": {
          "@type": "Place",
          "name": post.data.location,
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Shreveport",
            "addressRegion": "LA",
            "addressCountry": "US"
          }
        }
      } : {}))
    },
    ...((post.data.category === 'Events' || (post.data as any).categories?.includes('Events')) ? [
      {
        "@type": "Event",
        "@id": `${canonicalURL}#event`,
        "name": post.data.title,
        "startDate": new Date(post.data.date).toISOString(),
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "eventStatus": "https://schema.org/EventScheduled",
        ...(locationSchemas.length > 0 ? {
          "location": locationSchemas.length === 1 ? locationSchemas[0] : locationSchemas
        } : (post.data.location ? {
          "location": {
            "@type": "Place",
            "name": post.data.location,
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Shreveport",
              "addressRegion": "LA",
              "addressCountry": "US"
            }
          }
        } : {}))
      }
    ] : [])
  ]
};
---

<BaseLayout 
  title={`${post.data.title} — darlalovly`}
  description={post.data.description ?? post.data.excerpt ?? ''}
  image={heroImage}
  canonicalURL={canonicalURL}
  type="article"
  publishedTime={post.data.date}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} is:inline />

  <div id="crt-static-overlay" class="fixed inset-0 pointer-events-none z-[100] opacity-0 bg-neutral-950 flex items-center justify-center overflow-hidden" aria-hidden="true">
    <div class="tv-noise-layer absolute inset-0 pointer-events-none"></div>
    <div class="tv-horizontal-bar absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-tear-slice tv-tear-1 absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-tear-slice tv-tear-2 absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-vhold-blanking-bar absolute inset-x-0 h-16 pointer-events-none"></div>
    <div class="tv-interlace-odd absolute inset-0 pointer-events-none"></div>
    <div class="tv-interlace-even absolute inset-0 pointer-events-none"></div>
    <div class="tv-hsync-band tv-hsync-upper absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-hsync-band tv-hsync-lower absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-scanlines absolute inset-0 pointer-events-none"></div>
  </div>

  <div class="w-full max-w-4xl mx-auto flex flex-col pb-16">
    <article class="flex flex-col w-full">
      <header class="mb-10 sm:mb-14 flex flex-col items-center justify-center text-center space-y-4 sm:space-y-5">
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 font-mono text-[11px] sm:text-xs uppercase tracking-[0.2em] sm:tracking-[0.25em] text-neutral-400">
          <time datetime={new Date(post.data.date).toISOString()}>
            {formattedDate}
          </time>
          {post.data.location && (
            <>
              <span class="text-neutral-600">•</span>
              <span class="text-neutral-300">{post.data.location}</span>
            </>
          )}
        </div>

        <div class="relative w-full py-2 flex justify-center items-center select-none overflow-hidden">
          <h1 
            class="glitch-title font-sans font-normal text-white text-center break-words m-0"
            data-text={post.data.title}
          >
            {post.data.title}
          </h1>
        </div>
      </header>

      {heroImage && (
        <div class="mb-10 sm:mb-14 w-full flex justify-center">
          <div class="relative max-w-full overflow-hidden rounded-xl bg-neutral-900 border border-neutral-800 select-none flex items-center justify-center">
            <img 
              src={heroImage} 
              alt={post.data.title} 
              loading="eager"
              decoding="async"
              class="block w-auto h-auto max-w-full max-h-[85vh] object-contain mx-auto rounded-xl"
            />
          </div>
        </div>
      )}

      <!-- Clean Narrative Text -->
      <div class="prose prose-invert prose-neutral max-w-none font-sans text-neutral-200 leading-relaxed pt-2 break-words">
        <Content />
      </div>

      <!-- Structured Location Pins & Links Component -->
      {locations.length > 0 && (
        <section class="mt-12 pt-8 border-t border-neutral-800/80 flex flex-col gap-4 font-mono w-full clear-both" aria-label="Locations">
          <div class="flex items-center justify-between text-xs text-neutral-400 uppercase tracking-[0.2em]">
            <span>[ Location Pins & Links ]</span>
            <span>{locations.length} {locations.length === 1 ? 'Pin' : 'Pins'}</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {locations.map((loc: any) => {
              const lat = loc.lat ?? loc.latitude;
              const lng = loc.lng ?? loc.longitude ?? loc.lon;
              const mapsUrl = loc.url || loc.mapUrl || (lat && lng ? `https://www.google.com/maps/search/?api=1&query=${lat},${lng}` : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${loc.name || loc.title || ''} ${loc.address || ''}`)}`);
              return (
                <a
                  href={mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-start gap-3 p-3.5 rounded-xl bg-neutral-900/60 border border-neutral-800 hover:border-neutral-600 transition-colors group select-none text-left"
                >
                  <span class="text-base select-none">📍</span>
                  <div class="flex flex-col min-w-0">
                    <span class="text-white group-hover:underline font-sans text-sm font-medium truncate">
                      {loc.name || loc.title || loc.label}
                    </span>
                    {loc.address && (
                      <span class="text-neutral-400 font-mono text-[11px] mt-0.5 break-words">
                        {loc.address}
                      </span>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <!-- Structured Photo Archive Gallery Component -->
      {galleryItems.length > 0 && (
        <section class="my-12 pt-8 border-t border-neutral-800/80 clear-both w-full select-none" aria-label="Photo Archive">
          <div class="mb-6 flex items-center justify-between font-mono text-xs text-neutral-400 uppercase tracking-[0.2em]">
            <span>[ Photo Archive ]</span>
            <span>{galleryItems.length} {galleryItems.length === 1 ? 'Image' : 'Images'}</span>
          </div>
          <div class="columns-1 sm:columns-2 md:columns-3 gap-4 space-y-4">
            {galleryItems.map((item: any) => {
              const itemKey = typeof item === 'string' ? item : (item.src || item.key);
              const itemSrc = resolveImageUrl(itemKey);
              const altText = typeof item === 'object' ? (item.alt || item.caption || '') : '';

              return (
                <figure class="break-inside-avoid relative overflow-hidden rounded-xl bg-neutral-900 border border-neutral-800 mb-4">
                  <img
                    src={itemSrc}
                    alt={altText || post.data.title}
                    loading="lazy"
                    decoding="async"
                    class="block w-full h-auto object-contain rounded-xl"
                  />
                  {altText && (
                    <figcaption class="p-3 text-[11px] font-mono text-neutral-400 bg-neutral-950/90 border-t border-neutral-800/80 text-center leading-snug">
                      {altText}
                    </figcaption>
                  )}
                </figure>
              );
            })}
          </div>
        </section>
      )}

      <nav class="mt-16 sm:mt-24 pt-8 sm:pt-12 border-t border-neutral-800 flex flex-row items-center justify-between gap-4 w-full select-none clear-both" aria-label="Post pagination">
        <div class="flex-1 flex justify-start min-w-0">
          {nextSlug && (
            <a
              href={`/posts/${nextSlug}`}
              class="post-nav-link group relative flex items-center gap-2 sm:gap-4 text-left transition-colors cursor-pointer max-w-full sm:max-w-sm py-2 active:opacity-70"
              rel="next"
            >
              {nextImage && (
                <div class="absolute bottom-full left-0 mb-3 hidden sm:block opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 ease-out z-30 p-1 bg-neutral-900 border border-neutral-800 rounded-lg shadow-2xl">
                  <img 
                    src={nextImage} 
                    alt={nextTitle || 'Next post'} 
                    loading="lazy"
                    class="max-h-28 max-w-[150px] w-auto h-auto object-cover rounded-md block"
                  />
                </div>
              )}

              <span class="text-3xl sm:text-5xl md:text-6xl font-mono text-white leading-none select-none transition-all duration-300 ease-out group-hover:-translate-x-1 sm:group-hover:-translate-x-2 group-hover:scale-110 sm:group-hover:scale-125 group-hover:drop-shadow-[0_0_10px_rgba(255,255,255,0.85)] flex-shrink-0">
                &lt;
              </span>

              <span class="font-sans text-xs sm:text-sm font-normal uppercase tracking-wider text-neutral-300 group-hover:text-white transition-colors line-clamp-2">
                {nextTitle}
              </span>
            </a>
          )}
        </div>

        <div class="flex-1 flex justify-end min-w-0">
          {prevSlug && (
            <a
              href={`/posts/${prevSlug}`}
              class="post-nav-link group relative flex items-center justify-end text-right gap-2 sm:gap-4 transition-colors cursor-pointer max-w-full sm:max-w-sm py-2 active:opacity-70"
              rel="prev"
            >
              <span class="font-sans text-xs sm:text-sm font-normal uppercase tracking-wider text-neutral-300 group-hover:text-white transition-colors line-clamp-2">
                {prevTitle}
              </span>

              <span class="text-3xl sm:text-5xl md:text-6xl font-mono text-white leading-none select-none transition-all duration-300 ease-out group-hover:translate-x-1 sm:group-hover:translate-x-2 group-hover:scale-110 sm:group-hover:scale-125 group-hover:drop-shadow-[0_0_10px_rgba(255,255,255,0.85)] flex-shrink-0">
                &gt;
              </span>

              {prevImage && (
                <div class="absolute bottom-full right-0 mb-3 hidden sm:block opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 ease-out z-30 p-1 bg-neutral-900 border border-neutral-800 rounded-lg shadow-2xl">
                  <img 
                    src={prevImage} 
                    alt={prevTitle || 'Previous post'} 
                    loading="lazy"
                    class="max-h-28 max-w-[150px] w-auto h-auto object-cover rounded-md block"
                  />
                </div>
              )}
            </a>
          )}
        </div>
      </nav>
    </article>
  </div>
</BaseLayout>

<script>
  import { navigate } from 'astro:transitions/client';

  const TRANSITION_MODES = [
    { name: 'mode-antenna-gust', delay: 280 },
    { name: 'mode-static-dissolve', delay: 280 },
    { name: 'mode-frame-tear', delay: 180 },
    { name: 'mode-vhold-slip', delay: 180 },
    { name: 'mode-interlace-jitter', delay: 190 },
    { name: 'mode-hsync-shift', delay: 180 }
  ];

  const STORAGE_KEY = 'darlalovly_last_transition_mode';

  function getNextNonRepeatingEffect() {
    try {
      const lastMode = sessionStorage.getItem(STORAGE_KEY);
      const candidatePool = TRANSITION_MODES.filter((mode) => mode.name !== lastMode);
      const chosenEffect = candidatePool[Math.floor(Math.random() * candidatePool.length)] || TRANSITION_MODES[0];
      sessionStorage.setItem(STORAGE_KEY, chosenEffect.name);
      return chosenEffect;
    } catch {
      return TRANSITION_MODES[Math.floor(Math.random() * TRANSITION_MODES.length)];
    }
  }

  function initPostEngine() {
    const staticOverlay = document.getElementById('crt-static-overlay');
    if (staticOverlay) {
      staticOverlay.className = 'fixed inset-0 pointer-events-none z-[100] opacity-0 bg-neutral-950 flex items-center justify-center overflow-hidden';
    }

    const navLinks = document.querySelectorAll('.post-nav-link');
    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetHref = link.getAttribute('href');
        if (!targetHref) return;

        const selectedEffect = getNextNonRepeatingEffect();

        if (staticOverlay) {
          staticOverlay.className = `fixed inset-0 pointer-events-none z-[100] bg-neutral-950 flex items-center justify-center overflow-hidden is-active ${selectedEffect.name}`;
        }

        setTimeout(() => {
          navigate(targetHref);
        }, selectedEffect.delay);
      });
    });
  }

  document.addEventListener('astro:page-load', initPostEngine);
</script>

<style is:global>
  ::view-transition-group(root) {
    animation-duration: 260ms;
  }

  ::view-transition-old(root) {
    animation: 120ms steps(3) both crt-root-out;
  }

  ::view-transition-new(root) {
    animation: 140ms ease-out 80ms both crt-root-in;
  }

  @keyframes crt-root-out {
    0% { opacity: 1; filter: brightness(1); transform: none; }
    50% { opacity: 0.65; filter: contrast(1.3) brightness(0.7); transform: skewX(-1.5deg) translateX(3px); }
    100% { opacity: 0; filter: contrast(1.1) brightness(0.2); transform: skewX(1deg) translateX(-2px); }
  }

  @keyframes crt-root-in {
    0% { opacity: 0; filter: contrast(1.2) brightness(0.3); transform: skewX(1.5deg) translateX(-3px); }
    100% { opacity: 1; filter: brightness(1); transform: none; }
  }

  .prose img {
    border-radius: 0.75rem !important;
    border: none !important;
    max-width: 100% !important;
    height: auto !important;
    object-fit: contain !important;
  }
</style>

<style>
  #crt-static-overlay.is-active {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .tv-scanlines {
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.75) 0px,
      rgba(0, 0, 0, 0.75) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
  }

  .mode-antenna-gust .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='antennaGrain'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.2' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23antennaGrain)'/%3E%3C/svg%3E");
    background-size: 150px 150px;
    filter: contrast(180%) grayscale(100%) brightness(35%);
    opacity: 0.45;
    animation: jitter-step 0.07s steps(3) infinite;
  }
  .mode-antenna-gust .tv-horizontal-bar {
    top: -100px;
    height: 110px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    animation: bar-sweep 0.28s cubic-bezier(0.3, 0.1, 0.2, 1) infinite;
  }

  .mode-static-dissolve .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='dissolveNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.4' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23dissolveNoise)'/%3E%3C/svg%3E");
    background-size: 130px 130px;
    filter: contrast(170%) grayscale(100%) brightness(32%);
    opacity: 0.45;
    animation: jitter-step 0.08s steps(3) infinite;
  }

  .mode-frame-tear .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='tearNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.2' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23tearNoise)'/%3E%3C/svg%3E");
    background-size: 150px 150px;
    filter: contrast(180%) grayscale(100%) brightness(32%);
    opacity: 0.45;
    animation: jitter-step 0.05s steps(2) infinite;
  }
  .mode-frame-tear .tv-tear-slice {
    background: rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }
  .mode-frame-tear .tv-tear-1 {
    top: 22%;
    height: 38px;
    animation: tear-shift-left 0.09s steps(2) infinite alternate;
  }
  .mode-frame-tear .tv-tear-2 {
    top: 68%;
    height: 24px;
    animation: tear-shift-right 0.08s steps(2) infinite alternate;
  }

  .mode-vhold-slip .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='vholdNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.2' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23vholdNoise)'/%3E%3C/svg%3E");
    background-size: 150px 150px;
    filter: contrast(180%) grayscale(100%) brightness(30%);
    opacity: 0.5;
    animation: jitter-step 0.06s steps(3) infinite;
  }
  .mode-vhold-slip .tv-vhold-blanking-bar {
    top: -80px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.95) 20%,
      rgba(255, 255, 255, 0.12) 50%,
      rgba(0, 0, 0, 0.95) 80%,
      transparent 100%
    );
    animation: vhold-roll 0.18s ease-in forwards;
  }

  .mode-interlace-jitter .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='interlaceNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.3' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23interlaceNoise)'/%3E%3C/svg%3E");
    background-size: 140px 140px;
    filter: contrast(180%) grayscale(100%) brightness(32%);
    opacity: 0.45;
    animation: jitter-step 0.06s steps(2) infinite;
  }
  .mode-interlace-jitter .tv-interlace-odd {
    background: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.06) 0px,
      rgba(255, 255, 255, 0.06) 2px,
      transparent 2px,
      transparent 4px
    );
    animation: interlace-odd-shift 0.08s steps(2) infinite;
