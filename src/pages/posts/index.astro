---
// File: src/pages/posts/index.astro

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const allPosts: CollectionEntry<'posts'>[] = await getCollection('posts');

const publishedPosts = allPosts
  .filter((p) => !p.data.isDraft && !p.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const archiveTitle = "Posts";
const archiveNote = "Wanderings, unexpected detours, and visual archives along the open road.";
const cloudflareBase = import.meta.env.PUBLIC_R2_URL || "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/";

const resolveImageUrl = (imgKey?: string): string | undefined => {
  if (!imgKey) return undefined;
  if (imgKey.startsWith('http://') || imgKey.startsWith('https://') || imgKey.startsWith('/')) {
    return imgKey;
  }
  const cleanBase = cloudflareBase.endsWith('/') ? cloudflareBase : `${cloudflareBase}/`;
  return `${cleanBase}${imgKey.replace(/^\/+/, '')}`;
};

const formatDate = (date: Date | string | undefined) => {
  if (!date) return "Date Pending";
  return new Date(date).toLocaleDateString('en-US', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  });
};
---

<BaseLayout 
  title="Posts | darlalovly"
  description={archiveNote}
>
  <div class="w-full max-w-4xl mx-auto pb-16">
    <header class="mb-14 border-b border-neutral-800 pb-10 flex flex-col items-start gap-4">
      <div class="text-xs font-mono uppercase tracking-[0.2em] text-neutral-400">
        [ {publishedPosts.length} {publishedPosts.length === 1 ? 'entry' : 'entries'} ]
      </div>
      <h1 class="text-3xl sm:text-5xl font-mono uppercase tracking-widest text-white m-0">
        {archiveTitle}
      </h1>
      <p class="text-sm sm:text-base text-neutral-300 font-mono tracking-wide max-w-2xl leading-relaxed m-0">
        {archiveNote}
      </p>
    </header>

    <div class="flex flex-col gap-10">
      {publishedPosts.map((post) => {
        const postSlug = post.id ? post.id.replace(/\.(md|mdx)$/, '') : '';
        const postData = post.data as any;
        const thumbUrl = resolveImageUrl(postData.thumbnailKey || postData.image || (postData.gallery && postData.gallery[0]));
        
        return (
          <article class="border border-neutral-800/80 bg-neutral-900/40 p-6 sm:p-8 transition-colors hover:border-neutral-600 rounded-xl">
            <a href={`/posts/${postSlug}`} class="post-transition-link group flex flex-col md:flex-row gap-6 sm:gap-8 items-start">
              {thumbUrl && (
                <div class="w-full md:w-64 flex-shrink-0 overflow-hidden bg-neutral-900 rounded-xl">
                  <img 
                    src={thumbUrl} 
                    alt={post.data.title}
                    loading="lazy"
                    class="w-full h-48 md:h-44 object-cover rounded-xl transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              )}

              <div class="flex flex-col flex-1 gap-3">
                <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-widest text-neutral-400">
                  <span>{formatDate(post.data.date)}</span>
                  {post.data.location && (
                    <>
                      <span class="text-neutral-600">•</span>
                      <span>{post.data.location}</span>
                    </>
                  )}
                </div>

                <h2 class="text-xl sm:text-2xl font-mono uppercase tracking-wide text-white group-hover:text-neutral-300 transition-colors m-0">
                  {post.data.title}
                </h2>

                {(post.data.excerpt || post.data.description) && (
                  <p class="text-sm text-neutral-300 line-clamp-3 leading-relaxed m-0 font-sans">
                    {post.data.excerpt || post.data.description}
                  </p>
                )}

                <div class="pt-2 text-xs font-mono uppercase tracking-widest text-neutral-400 group-hover:text-white transition-colors">
                  View Post &rarr;
                </div>
              </div>
            </a>
          </article>
        );
      })}

      {publishedPosts.length === 0 && (
        <div class="py-16 text-center text-sm font-mono uppercase tracking-widest text-neutral-500">
          [ No posts published yet ]
        </div>
      )}
    </div>
  </div>
</BaseLayout>