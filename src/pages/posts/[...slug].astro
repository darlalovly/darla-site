---
import { getCollection, render } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const posts = await getCollection('field_notes', (post) => !post.data.isDraft);
const sortedPosts = posts.sort((a, b) => new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf());

const getSlug = (p: any) => p.slug || (p.id ? p.id.replace(/\.(md|mdx)$/, '') : '');

const currentIndex = sortedPosts.findIndex((p) => getSlug(p) === slug);

if (currentIndex === -1) {
  return Astro.redirect('/404');
}

const post = sortedPosts[currentIndex];
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

const prevSlug = prevPost ? getSlug(prevPost) : null;
const prevTitle = prevPost ? prevPost.data.title : null;
const prevImage = prevPost ? prevPost.data.image : null;

const nextSlug = nextPost ? getSlug(nextPost) : null;
const nextTitle = nextPost ? nextPost.data.title : null;
const nextImage = nextPost ? nextPost.data.image : null;

const { Content } = await render(post);
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url);

const formatDate = (dateVal: string | Date) => {
  if (!dateVal) return '';
  const d = dateVal instanceof Date ? dateVal : new Date(dateVal);
  if (isNaN(d.getTime())) return String(dateVal);
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
};

const formattedDate = formatDate(post.data.date);
---

<BaseLayout 
  title={`${post.data.title} — darlalovly`}
  description={post.data.description ?? ''}
  image={post.data.image}
  canonicalURL={canonicalURL}
>
  <ClientRouter />

  <!-- Multi-Mode Analog TV Signal Transition Overlay -->
  <div id="crt-static-overlay" class="fixed inset-0 pointer-events-none z-[100] opacity-0 bg-neutral-950 flex items-center justify-center overflow-hidden" aria-hidden="true">
    <div class="tv-noise-layer absolute inset-0 pointer-events-none"></div>
    <div class="tv-horizontal-bar absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-tear-slice tv-tear-1 absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-tear-slice tv-tear-2 absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-vhold-blanking-bar absolute inset-x-0 h-16 pointer-events-none"></div>
    <div class="tv-interlace-odd absolute inset-0 pointer-events-none"></div>
    <div class="tv-interlace-even absolute inset-0 pointer-events-none"></div>
    <div class="tv-hsync-band tv-hsync-upper absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-hsync-band tv-hsync-lower absolute inset-x-0 pointer-events-none"></div>
    <div class="tv-scanlines absolute inset-0 pointer-events-none"></div>
  </div>

  <!-- Ambient Static Texture Canvas Overlay -->
  <div class="fixed inset-0 pointer-events-none z-50 animated-noise-overlay" aria-hidden="true"></div>

  <div class="min-h-screen bg-neutral-950 text-white selection:bg-white selection:text-neutral-900 font-sans antialiased overflow-x-hidden flex flex-col justify-between relative z-10">
    <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 pt-12 sm:pt-16 md:pt-24 pb-20 flex flex-col">
      <article class="flex flex-col w-full">
        <header class="mb-10 sm:mb-14 flex flex-col items-center justify-center text-center space-y-4 sm:space-y-5">
          <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 font-mono text-[11px] sm:text-xs uppercase tracking-[0.2em] sm:tracking-[0.25em] text-neutral-400">
            <time datetime={new Date(post.data.date).toISOString()}>
              {formattedDate}
            </time>
            {post.data.location && (
              <>
                <span class="text-neutral-600">•</span>
                <span class="text-neutral-300">{post.data.location}</span>
              </>
            )}
          </div>

          <div class="relative w-full py-2 flex justify-center items-center select-none overflow-hidden">
            <h1 
              class="glitch-title font-sans font-normal text-white text-center break-words"
              data-text={post.data.title}
            >
              {post.data.title}
            </h1>
          </div>
        </header>

        <div class="prose prose-invert prose-neutral max-w-none font-sans text-neutral-200 leading-relaxed pt-2 flex flex-col space-y-6 break-words">
          <Content />
        </div>

        <nav class="mt-16 sm:mt-24 pt-8 sm:pt-12 border-t border-neutral-800 flex flex-row items-center justify-between gap-4 w-full">
          <!-- Next Post: Left Position -->
          <div class="flex-1 flex justify-start min-w-0">
            {nextSlug && (
              <a
                href={`/posts/${nextSlug}`}
                class="post-nav-link group relative flex items-center gap-2 sm:gap-4 text-left transition-colors cursor-pointer max-w-full sm:max-w-sm py-2 active:opacity-70"
                rel="next"
              >
                {nextImage && (
                  <img 
                    src={nextImage} 
                    alt={nextTitle || 'Next dispatch'} 
                    loading="lazy"
                    class="absolute bottom-full left-0 mb-3 hidden sm:block opacity-0 translate-y-2 pointer-events-none group-hover:opacity-40 group-hover:translate-y-0 transition-all duration-300 ease-out z-30 max-h-24 max-w-[130px] w-auto h-auto object-contain bg-transparent border-none shadow-none"
                  />
                )}

                <span class="text-3xl sm:text-5xl md:text-6xl font-mono text-white leading-none select-none transition-all duration-300 ease-out group-hover:-translate-x-1 sm:group-hover:-translate-x-2 group-hover:scale-110 sm:group-hover:scale-125 group-hover:drop-shadow-[0_0_10px_rgba(255,255,255,0.85)] flex-shrink-0">
                  &lt;
                </span>

                <span class="font-sans text-xs sm:text-sm font-normal uppercase tracking-wider text-neutral-300 group-hover:text-white transition-colors line-clamp-2">
                  {nextTitle}
                </span>
              </a>
            )}
          </div>

          <!-- Previous Post: Right Position -->
          <div class="flex-1 flex justify-end min-w-0">
            {prevSlug && (
              <a
                href={`/posts/${prevSlug}`}
                class="post-nav-link group relative flex items-center justify-end text-right gap-2 sm:gap-4 transition-colors cursor-pointer max-w-full sm:max-w-sm py-2 active:opacity-70"
                rel="prev"
              >
                {prevImage && (
                  <img 
                    src={prevImage} 
                    alt={prevTitle || 'Previous dispatch'} 
                    loading="lazy"
                    class="absolute bottom-full right-0 mb-3 hidden sm:block opacity-0 translate-y-2 pointer-events-none group-hover:opacity-40 group-hover:translate-y-0 transition-all duration-300 ease-out z-30 max-h-24 max-w-[130px] w-auto h-auto object-contain bg-transparent border-none shadow-none"
                  />
                )}

                <span class="font-sans text-xs sm:text-sm font-normal uppercase tracking-wider text-neutral-300 group-hover:text-white transition-colors line-clamp-2">
                  {prevTitle}
                </span>

                <span class="text-3xl sm:text-5xl md:text-6xl font-mono text-white leading-none select-none transition-all duration-300 ease-out group-hover:translate-x-1 sm:group-hover:translate-x-2 group-hover:scale-110 sm:group-hover:scale-125 group-hover:drop-shadow-[0_0_10px_rgba(255,255,255,0.85)] flex-shrink-0">
                  &gt;
                </span>
              </a>
            )}
          </div>
        </nav>
      </article>
    </main>

    <footer class="border-t border-neutral-800 bg-neutral-950 py-12 px-6 flex flex-col items-center justify-center">
      <div class="max-w-6xl mx-auto flex items-center justify-center text-xs text-neutral-400 font-mono text-center">
        <span>© {new Date().getFullYear()} darlalovly</span>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  import { navigate } from 'astro:transitions/client';

  const TRANSITION_MODES = [
    { name: 'mode-antenna-gust', delay: 280 },
    { name: 'mode-static-dissolve', delay: 280 },
    { name: 'mode-frame-tear', delay: 180 },
    { name: 'mode-vhold-slip', delay: 180 },
    { name: 'mode-interlace-jitter', delay: 190 },
    { name: 'mode-hsync-shift', delay: 180 }
  ];

  const STORAGE_KEY = 'darlalovly_last_transition_mode';

  function getNextNonRepeatingEffect() {
    try {
      const lastMode = sessionStorage.getItem(STORAGE_KEY);
      const candidatePool = TRANSITION_MODES.filter((mode) => mode.name !== lastMode);
      const chosenEffect = candidatePool[Math.floor(Math.random() * candidatePool.length)] || TRANSITION_MODES[0];
      sessionStorage.setItem(STORAGE_KEY, chosenEffect.name);
      return chosenEffect;
    } catch {
      return TRANSITION_MODES[Math.floor(Math.random() * TRANSITION_MODES.length)];
    }
  }

  document.addEventListener('astro:page-load', () => {
    const staticOverlay = document.getElementById('crt-static-overlay');
    if (staticOverlay) {
      staticOverlay.className = 'fixed inset-0 pointer-events-none z-[100] opacity-0 bg-neutral-950 flex items-center justify-center overflow-hidden';
    }

    const navLinks = document.querySelectorAll('.post-nav-link');
    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetHref = link.getAttribute('href');
        if (!targetHref) return;

        const selectedEffect = getNextNonRepeatingEffect();

        if (staticOverlay) {
          staticOverlay.className = `fixed inset-0 pointer-events-none z-[100] bg-neutral-950 flex items-center justify-center overflow-hidden is-active ${selectedEffect.name}`;
        }

        setTimeout(() => {
          navigate(targetHref);
        }, selectedEffect.delay);
      });
    });
  });
</script>

<style is:global>
  html, body {
    background-color: #0a0a0a !important;
    color: #ffffff !important;
  }

  ::view-transition-group(root) {
    animation-duration: 260ms;
  }

  ::view-transition-old(root) {
    animation: 120ms steps(3) both crt-root-out;
  }

  ::view-transition-new(root) {
    animation: 140ms ease-out 80ms both crt-root-in;
  }

  @keyframes crt-root-out {
    0% { opacity: 1; filter: brightness(1); transform: none; }
    50% { opacity: 0.65; filter: contrast(1.3) brightness(0.7); transform: skewX(-1.5deg) translateX(3px); }
    100% { opacity: 0; filter: contrast(1.1) brightness(0.2); transform: skewX(1deg) translateX(-2px); }
  }

  @keyframes crt-root-in {
    0% { opacity: 0; filter: contrast(1.2) brightness(0.3); transform: skewX(1.5deg) translateX(-3px); }
    100% { opacity: 1; filter: brightness(1); transform: none; }
  }

  body > div, body > main, header, nav, footer {
    background-color: #0a0a0a !important;
  }

  header a img, .site-logo {
    filter: none !important;
    transition: opacity 0.3s ease-in-out;
  }
  header a img:hover, .site-logo:hover {
    opacity: 0.8;
  }

  nav img {
    filter: none !important;
    border: none !important;
    box-shadow: none !important;
    background-color: transparent !important;
  }

  .prose {
    color: #e5e5e5 !important;
  }
  .prose h1, .prose h2, .prose h3, .prose h4 {
    color: #ffffff !important;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .prose a {
    color: #ffffff !important;
    text-decoration-color: #525252;
  }
  .prose a:hover {
    text-decoration-color: #ffffff;
  }
  .prose blockquote {
    border-left-color: #404040 !important;
    color: #d4d4d4 !important;
  }
  .prose code {
    color: #f5f5f5 !important;
    background-color: #171717 !important;
  }
  .prose img {
    border-radius: 0.75rem !important;
    border: none !important;
    max-width: 100% !important;
    height: auto !important;
  }
</style>

<style>
  #crt-static-overlay.is-active {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .tv-scanlines {
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.75) 0px,
      rgba(0, 0, 0, 0.75) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
  }

  /* Mode 1: Antenna Gust */
  .mode-antenna-gust .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='antennaGrain'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.2' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23antennaGrain)'/%3E%3C/svg%3E");
    background-size: 150px 150px;
    filter: contrast(180%) grayscale(100%) brightness(35%);
    opacity: 0.45;
    animation: jitter-step 0.07s steps(3) infinite;
  }
  .mode-antenna-gust .tv-horizontal-bar {
    top: -100px;
    height: 110px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    animation: bar-sweep 0.28s cubic-bezier(0.3, 0.1, 0.2, 1) infinite;
  }

  /* Mode 2: Dim Static Dissolve */
  .mode-static-dissolve .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='dissolveNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.4' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23dissolveNoise)'/%3E%3C/svg%3E");
    background-size: 130px 130px;
    filter: contrast(170%) grayscale(100%) brightness(32%);
    opacity: 0.45;
    animation: jitter-step 0.08s steps(3) infinite;
  }

  /* Mode 3: Stepped Frame Tear */
  .mode-frame-tear .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='tearNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.2' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23tearNoise)'/%3E%3C/svg%3E");
    background-size: 150px 150px;
    filter: contrast(180%) grayscale(100%) brightness(32%);
    opacity: 0.45;
    animation: jitter-step 0.05s steps(2) infinite;
  }
  .mode-frame-tear .tv-tear-slice {
    background: rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }
  .mode-frame-tear .tv-tear-1 {
    top: 22%;
    height: 38px;
    animation: tear-shift-left 0.09s steps(2) infinite alternate;
  }
  .mode-frame-tear .tv-tear-2 {
    top: 68%;
    height: 24px;
    animation: tear-shift-right 0.08s steps(2) infinite alternate;
  }

  /* Mode 4: Fast V-Hold Vertical Sync Roll */
  .mode-vhold-slip .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='vholdNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.2' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23vholdNoise)'/%3E%3C/svg%3E");
    background-size: 150px 150px;
    filter: contrast(180%) grayscale(100%) brightness(30%);
    opacity: 0.5;
    animation: jitter-step 0.06s steps(3) infinite;
  }
  .mode-vhold-slip .tv-vhold-blanking-bar {
    top: -80px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.95) 20%,
      rgba(255, 255, 255, 0.12) 50%,
      rgba(0, 0, 0, 0.95) 80%,
      transparent 100%
    );
    animation: vhold-roll 0.18s ease-in forwards;
  }

  /* Mode 5: Interlaced Field Desync */
  .mode-interlace-jitter .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='interlaceNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.3' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23interlaceNoise)'/%3E%3C/svg%3E");
    background-size: 140px 140px;
    filter: contrast(180%) grayscale(100%) brightness(32%);
    opacity: 0.45;
    animation: jitter-step 0.06s steps(2) infinite;
  }
  .mode-interlace-jitter .tv-interlace-odd {
    background: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.06) 0px,
      rgba(255, 255, 255, 0.06) 2px,
      transparent 2px,
      transparent 4px
    );
    animation: interlace-odd-shift 0.08s steps(2) infinite;
  }
  .mode-interlace-jitter .tv-interlace-even {
    background: repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 2px,
      rgba(255, 255, 255, 0.04) 2px,
      rgba(255, 255, 255, 0.04) 4px
    );
    animation: interlace-even-shift 0.08s steps(2) infinite;
  }

  /* Mode 6: H-Sync Phase Shift */
  .mode-hsync-shift .tv-noise-layer {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='hsyncNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.25' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23hsyncNoise)'/%3E%3C/svg%3E");
    background-size: 140px 140px;
    filter: contrast(180%) grayscale(100%) brightness(30%);
    opacity: 0.45;
    animation: jitter-step 0.06s steps(2) infinite;
  }
  .mode-hsync-shift .tv-hsync-band {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 50%,
      transparent 100%
    );
    pointer-events: none;
  }
  .mode-hsync-shift .tv-hsync-upper {
    top: 18%;
    height: 44px;
    animation: hsync-skew-left 0.09s steps(2) infinite alternate;
  }
  .mode-hsync-shift .tv-hsync-lower {
    top: 62%;
    height: 32px;
    animation: hsync-skew-right 0.08s steps(2) infinite alternate;
  }

  @keyframes jitter-step {
    0% { transform: translate(0, 0); }
    50% { transform: translate(-2px, 1px); }
    100% { transform: translate(2px, -1px); }
  }

  @keyframes bar-sweep {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(115vh); }
  }

  @keyframes tear-shift-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-12px); }
  }

  @keyframes tear-shift-right {
    0% { transform: translateX(0); }
    100% { transform: translateX(10px); }
  }

  @keyframes vhold-roll {
    0% { transform: translateY(0); }
    100% { transform: translateY(115vh); }
  }

  @keyframes interlace-odd-shift {
    0% { transform: translateX(0); }
    50% { transform: translateX(-6px); }
    100% { transform: translateX(4px); }
  }

  @keyframes interlace-even-shift {
    0% { transform: translateX(0); }
    50% { transform: translateX(6px); }
    100% { transform: translateX(-4px); }
  }

  @keyframes hsync-skew-left {
    0% { transform: skewX(-4deg) translateX(0); }
    100% { transform: skewX(-4deg) translateX(-14px); }
  }

  @keyframes hsync-skew-right {
    0% { transform: skewX(3deg) translateX(0); }
    100% { transform: skewX(3deg) translateX(12px); }
  }

  .glitch-title {
    position: relative;
    display: inline-block;
    font-size: clamp(2rem, 5.5vw, 4rem);
    letter-spacing: 0.05em;
    line-height: 1.15;
    max-width: 100%;
    word-break: normal;
    text-transform: uppercase;
    cursor: default;
    color: #ffffff !important;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
  }

  .glitch-title::before,
  .glitch-title::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    pointer-events: none;
  }

  .glitch-title::before {
    left: 2px;
    text-shadow: -2px 0 #a3a3a3, 1px 0 #e5e5e5;
    clip-path: inset(0 0 100% 0);
    animation: tv-static-glitch-1 3.2s infinite linear alternate-reverse;
  }

  .glitch-title::after {
    left: -2px;
    text-shadow: 2px 0 #ffffff, -1px 0 #d4d4d4;
    clip-path: inset(0 0 100% 0);
    animation: tv-static-glitch-2 2.6s infinite linear alternate-reverse;
  }

  @keyframes tv-static-glitch-1 {
    0%, 80%, 100% {
      clip-path: inset(0 0 100% 0);
      transform: translate(0);
      opacity: 0.9;
    }
    82% {
      clip-path: inset(20% 0 50% 0);
      transform: translate(-3px, 1px);
      opacity: 0.75;
    }
    86% {
      clip-path: inset(60% 0 15% 0);
      transform: translate(3px, -1px);
      opacity: 0.85;
    }
    90% {
      clip-path: inset(10% 0 70% 0);
      transform: translate(-2px, 2px);
      opacity: 0.6;
    }
    95% {
      clip-path: inset(75% 0 8% 0);
      transform: translate(2px, -2px);
      opacity: 0.9;
    }
  }

  @keyframes tv-static-glitch-2 {
    0%, 75%, 100% {
      clip-path: inset(0 0 100% 0);
      transform: translate(0);
      opacity: 0.9;
    }
    78% {
      clip-path: inset(40% 0 35% 0);
      transform: translate(4px, -1px);
      opacity: 0.7;
    }
    83% {
      clip-path: inset(12% 0 72% 0);
      transform: translate(-3px, 1px);
      opacity: 0.8;
    }
    88% {
      clip-path: inset(68% 0 12% 0);
      transform: translate(2px, -2px);
      opacity: 0.65;
    }
    93% {
      clip-path: inset(25% 0 60% 0);
      transform: translate(-2px, 1px);
      opacity: 0.85;
    }
  }

  .animated-noise-overlay {
    opacity: 0.12;
    mix-blend-mode: screen;
    animation: grain-motion 0.3s steps(5) infinite;
  }

  @keyframes grain-motion {
    0% { transform: translate(0, 0); }
    20% { transform: translate(-3px, 2px); }
    40% { transform: translate(3px, -1px); }
    60% { transform: translate(-2px, 3px); }
    80% { transform: translate(2px, -2px); }
    100% { transform: translate(-1px, 1px); }
  }
</style>