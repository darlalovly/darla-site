---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('field_notes');
  const validPosts = posts.filter((post) => !post.data.isDraft);
  const sortedPosts = validPosts.sort((a, b) => new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf());

  return sortedPosts.map((post, index) => {
    const slug = post.id.replace(/\.mdx?$/, '');
    const prevPost = index > 0 ? sortedPosts[index - 1] : null;
    const nextPost = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;

    return {
      params: { slug },
      props: {
        post,
        prevSlug: prevPost ? prevPost.id.replace(/\.mdx?$/, '') : null,
        prevTitle: prevPost ? prevPost.data.title : null,
        nextSlug: nextPost ? nextPost.id.replace(/\.mdx?$/, '') : null,
        nextTitle: nextPost ? nextPost.data.title : null,
      },
    };
  });
}

const { post, prevSlug, prevTitle, nextSlug, nextTitle } = Astro.props;

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);
const siteUrl = Astro.site ? Astro.site.href : 'https://darlalovly.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<BaseLayout 
  title={`${post.data.title} — darlalovly`}
  description={post.data.description ?? ''}
  image={post.data.image}
  canonicalURL={canonicalURL}
>
  <article class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-8 border-b border-neutral-200 pb-6 text-center dark:border-neutral-800">
      <div class="mb-3 flex items-center justify-center gap-2 text-xs uppercase tracking-wider text-neutral-500">
        <time datetime={new Date(post.data.date).toISOString()}>
          {new Date(post.data.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC'
          })}
        </time>
        {post.data.location && (
          <>
            <span>•</span>
            <span>{post.data.location}</span>
          </>
        )}
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-4xl">
        {post.data.title}
      </h1>
    </header>

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <Content />
    </div>

    <nav class="mt-12 flex items-center justify-between border-t border-neutral-200 pt-6 text-sm font-medium dark:border-neutral-800">
      {prevSlug ? (
        <a
          href={`/posts/${prevSlug}`}
          class="flex items-center gap-2 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors"
          rel="prev"
        >
          <span>←</span>
          <span>{prevTitle}</span>
        </a>
      ) : (
        <div />
      )}

      {nextSlug ? (
        <a
          href={`/posts/${nextSlug}`}
          class="flex items-center gap-2 text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 transition-colors text-right"
          rel="next"
        >
          <span>{nextTitle}</span>
          <span>→</span>
        </a>
      ) : (
        <div />
      )}
    </nav>
  </article>
</BaseLayout>