---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('field_notes');
  const sortedPosts = posts
    .filter((post) => !post.data.isDraft)
    .sort((a, b) => new Date(a.data.date).valueOf() - new Date(b.data.date).valueOf());

  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: index > 0 ? sortedPosts[index - 1] : null,
      nextPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const siteUrl = Astro.site ? Astro.site.href : 'https://darlalovly.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<BaseLayout 
  title={`${post.data.title} — darlalovly`}
  description={post.data.description ?? ''}
  image={post.data.image}
  canonicalURL={canonicalURL}
>
  <article class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-8 border-b border-neutral-200 pb-6 text-center">
      <div class="mb-3 flex items-center justify-center gap-2 text-xs uppercase tracking-wider text-neutral-500">
        <time datetime={new Date(post.data.date).toISOString()}>
          {new Date(post.data.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC'
          })}
        </time>
        {post.data.location && (
          <>
            <span>•</span>
            <span>{post.data.location}</span>
          </>
        )}
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        {post.data.title}
      </h1>
    </header>

    <div class="prose prose-neutral max-w-none [&_div>img]:mx-auto [&_div>img]:max-h-[70vh] [&_div>img]:w-auto [&_div>img]:rounded-xl [&_div>img]:object-contain [&_p>img]:mx-auto [&_p>img]:max-h-[70vh] [&_p>img]:w-auto [&_p>img]:rounded-xl [&_p>img]:object-contain [&_a_img]:inline-block [&_a_img]:my-0 [&_a_img]:h-5 [&_a_img]:w-5 [&_a_img]:max-h-5 [&_a_img]:rounded-none">
      <Content />
    </div>

    <nav class="mt-12 flex items-center justify-between border-t border-neutral-200 pt-6 text-sm font-medium">
      {prevPost ? (
        <a
          href={`/posts/${prevPost.id}`}
          class="flex items-center gap-2 text-neutral-600 hover:text-neutral-900 transition-colors"
          rel="prev"
        >
          <span>←</span>
          <span>{prevPost.data.title}</span>
        </a>
      ) : (
        <div />
      )}

      {nextPost ? (
        <a
          href={`/posts/${nextPost.id}`}
          class="flex items-center gap-2 text-neutral-600 hover:text-neutral-900 transition-colors text-right"
          rel="next"
        >
          <span>{nextPost.data.title}</span>
          <span>→</span>
        </a>
      ) : (
        <div />
      )}
    </nav>
  </article>
</BaseLayout>