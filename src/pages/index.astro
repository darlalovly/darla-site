---
// File: src/pages/index.astro

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

const cloudflareBase = import.meta.env.PUBLIC_R2_URL || "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/";

let rawPosts: any[] = [];
try {
  rawPosts = await getCollection('posts');
} catch {
  rawPosts = [];
}

let rawRecipes: any[] = [];
try {
  rawRecipes = await getCollection('recipes');
} catch {
  rawRecipes = [];
}

const postsList = (rawPosts || []).filter((p) => !p?.data?.isDraft && !p?.data?.draft);
const recipesList = (rawRecipes || []).filter((r) => !r?.data?.isDraft && !r?.data?.draft);

const parseDate = (val: any): Date => {
  if (!val) return new Date(0);
  const d = val instanceof Date ? val : new Date(val);
  return isNaN(d.getTime()) ? new Date(0) : d;
};

const formatDate = (dateVal: any): string => {
  const d = parseDate(dateVal);
  if (d.getTime() === 0) return '';
  return d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).toUpperCase();
};

const resolveImageUrl = (img: any): string | undefined => {
  if (!img) return undefined;
  if (typeof img === 'string') {
    if (img.startsWith('http://') || img.startsWith('https://') || img.startsWith('/')) {
      return img;
    }
    const cleanBase = cloudflareBase.endsWith('/') ? cloudflareBase : `${cloudflareBase}/`;
    return `${cleanBase}${img.replace(/^\/+/, '')}`;
  }
  if (typeof img === 'object' && img?.src) {
    return img.src;
  }
  return undefined;
};

const detectOrientation = (data: any): 'portrait' | 'landscape' | 'square' => {
  const raw = String(
    data?.heroOrientation ||
    data?.orientation ||
    data?.imageOrientation ||
    data?.aspectRatio ||
    data?.aspect ||
    ''
  ).toLowerCase();
  if (raw.includes('portrait') || raw.includes('vertical') || raw.includes('9/16') || raw.includes('9:16') || raw.includes('9x12')) return 'portrait';
  if (raw.includes('square') || raw.includes('1/1') || raw.includes('1:1')) return 'square';
  return 'landscape';
};

const combinedEntries = [
  ...postsList.map((post) => {
    const slug = (post as any).slug || (post.id ? post.id.replace(/\.(md|mdx)$/, '') : '');
    const imgKey = post.data?.image || post.data?.thumbnailKey || (post.data?.gallery && post.data?.gallery[0]);
    const orientation = detectOrientation(post.data);
    return {
      title: post.data?.title || 'Untitled Post',
      date: parseDate(post.data?.date || post.data?.pubDate || post.data?.timestamp),
      image: resolveImageUrl(imgKey),
      orientation,
      isVertical: orientation === 'portrait',
      excerpt: post.data?.excerpt || post.data?.description || '',
      category: post.data?.category || 'Post',
      type: 'POST',
      href: `/posts/${slug}`,
    };
  }),
  ...recipesList.map((recipe) => {
    const imgKey = recipe.data?.thumbnailKey || (recipe.data?.gallery && recipe.data?.gallery[0]);
    const orientation = detectOrientation(recipe.data);
    return {
      title: recipe.data?.recipeName || recipe.data?.title || 'Untitled Recipe',
      date: parseDate(recipe.data?.date),
      image: resolveImageUrl(imgKey),
      orientation,
      isVertical: orientation === 'portrait',
      excerpt: recipe.data?.recipeExcerpt || '',
      category: 'Recipe',
      type: 'RECIPE',
      href: `/recipes/${recipe.id.replace(/\.(md|mdx)$/, '')}`,
    };
  }),
];

const feed = combinedEntries.sort((a, b) => b.date.valueOf() - a.date.valueOf());
const featuredItem = feed[0];
const streamItems = feed.slice(1);
---

<BaseLayout 
  title="darlalovly — Personal Posts, Places & Scent"
  enableAudioTransition={true}
  noindex={true}
>
  <!-- Primary Vertical Stream Centering Wrapper -->
  <div class="w-full flex flex-col items-center justify-between relative z-10 dot-bg overflow-x-clip px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-5xl mx-auto pt-8 sm:pt-12 pb-20 flex flex-col items-center">
      
      <!-- HERO TITLE -->
      <header class="relative mb-20 md:mb-28 flex flex-col items-center justify-center text-center space-y-6 animate-fade-in w-full overflow-hidden">
        <div class="relative w-full py-4 flex justify-center items-center select-none overflow-hidden">
          <h1
            class="glitch-title font-mono font-normal text-white leading-[0.9] text-center"
            data-text="darlalovly"
          >
            darlalovly
          </h1>
        </div>

        <div class="pt-2 flex items-center justify-center gap-3 text-xs uppercase tracking-[0.25em] text-neutral-400 font-mono">
          <a href="#intro" class="group inline-flex items-center gap-2 text-neutral-400 hover:text-white transition-colors">
            <span>Scroll to explore</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
            </svg>
          </a>
        </div>
      </header>

      <!-- STAGGERED INTRO QUOTES -->
      <section id="intro" class="w-full mb-24 sm:mb-32 pt-16 border-t border-neutral-800 space-y-20 sm:space-y-28">
        <div class="glitch-reveal-item mr-auto max-w-2xl text-left">
          <p class="font-mono uppercase tracking-[0.14em] text-base sm:text-lg md:text-xl text-white leading-relaxed m-0">
            My personal space for wandering thoughts, unexpected detours, and local discoveries along the open road.
          </p>
        </div>

        <div class="glitch-reveal-item ml-auto max-w-2xl text-right">
          <p class="font-mono uppercase tracking-[0.14em] text-base sm:text-lg md:text-xl text-neutral-300 leading-relaxed m-0">
            Written plainly from real, learned-life experience - no expert guides, no heavy photography, just stories as I see them.[cite: 18]
          </p>
        </div>

        <div class="glitch-reveal-item mx-auto max-w-2xl text-center">
          <p class="font-mono uppercase tracking-[0.14em] text-base sm:text-lg md:text-xl text-neutral-400 leading-relaxed m-0">
            Paying attention to the little details, one step at a time, where fragrant memories mingle with everyday moments.[cite: 18]
          </p>
        </div>
      </section>

      <!-- STREAM CONTAINER -->
      <section id="feed" class="w-full pt-12 border-t border-neutral-800 flex flex-col items-center">
        
        <div class="w-full flex items-center justify-between mb-12 sm:mb-16 pb-4 border-b border-neutral-800/60 font-mono">
          <span class="text-xs uppercase tracking-[0.25em] text-neutral-400">
            [ Digital Garden & Posts ][cite: 18]
          </span>
          <span class="text-xs uppercase tracking-[0.2em] text-neutral-500">
            {feed.length} {feed.length === 1 ? 'Entry' : 'Entries'}[cite: 18]
          </span>
        </div>

        <!-- 1. FEATURED ENTRY -->
        {featuredItem && (
          <article id="featured-post" class="w-full mb-20 sm:mb-28 glitch-reveal-item flex flex-col items-center">
            <a
              href={featuredItem.href}
              class={`post-transition-link group flex ${
                featuredItem.isVertical
                  ? 'flex-col md:flex-row items-center gap-8 md:gap-14'
                  : 'flex-col items-center gap-8 text-center'
              } w-full`}
            >
              {featuredItem.image && (
                <div class={`featured-img-container flex items-center justify-center select-none ${
                  featuredItem.isVertical ? 'w-full md:w-1/2 flex-shrink-0' : 'w-full'
                }`}>
                  <div class="relative inline-flex overflow-hidden rounded-xl bg-transparent border-0 shadow-none justify-center items-center max-w-full">
                    <div class="absolute inset-0 pointer-events-none z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 crt-screen-vignette rounded-xl"></div>
                    <div class="absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 crt-scanlines rounded-xl"></div>
                    <img
                      src={featuredItem.image}
                      alt={featuredItem.title}
                      loading="eager"
                      class={`block w-auto h-auto max-w-full object-contain rounded-xl transition-transform duration-500 ease-out group-hover:scale-[1.02] ${
                        featuredItem.isVertical ? 'max-h-[650px]' : 'max-h-[520px]'
                      }`}
                    />
                  </div>
                </div>
              )}

              <div class={`featured-content-container flex flex-col gap-4 flex-1 w-full ${
                !featuredItem.isVertical ? 'max-w-3xl items-center text-center' : 'text-left'
              }`}>
                <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono tracking-widest text-neutral-400 w-full">
                  <span class="border border-neutral-700 px-2.5 py-1 text-[10px] text-white uppercase tracking-[0.2em]">
                    [ FEATURED {featuredItem.type} ][cite: 18]
                  </span>
                  <span>{formatDate(featuredItem.date)}</span>
                </div>

                <h2 class="text-2xl sm:text-4xl md:text-5xl font-mono uppercase tracking-wide text-white group-hover:text-neutral-300 transition-colors leading-tight m-0">
                  {featuredItem.title}
                </h2>

                {featuredItem.excerpt && (
                  <p class="text-base sm:text-lg text-neutral-300 font-sans leading-relaxed max-w-2xl m-0">
                    {featuredItem.excerpt}
                  </p>
                )}

                <div class="pt-2 text-xs font-mono uppercase tracking-widest text-neutral-400 group-hover:text-white transition-colors flex items-center gap-2">
                  <span>View Post</span>
                  <span class="transition-transform duration-300 group-hover:translate-x-1.5">&rarr;</span>
                </div>
              </div>
            </a>
          </article>
        )}

        <!-- 2. STREAM ITEMS -->
        <div class="flex flex-col gap-16 sm:gap-24 w-full items-center">
          {streamItems.map((entry, index) => {
            const formattedDate = formatDate(entry.date);
            const isReversed = index % 2 === 1;

            return (
              <article class="w-full glitch-reveal-item group flex flex-col border-b border-neutral-800/60 pb-16 last:border-0 last:pb-0">
                <a
                  href={entry.href}
                  class={`post-transition-link flex flex-col ${
                    isReversed ? 'md:flex-row-reverse' : 'md:flex-row'
                  } items-center gap-8 md:gap-14 justify-between w-full`}
                >
                  <div class="flex flex-col gap-4 flex-1 w-full text-left">
                    <div class="flex items-center gap-3 text-xs font-mono tracking-widest text-neutral-400">
                      <span class="border border-neutral-800 px-2 py-0.5 text-[10px] text-neutral-300">
                        {entry.type}
                      </span>
                      {formattedDate && <span>{formattedDate}</span>}
                    </div>

                    <h2 class="text-xl sm:text-2xl md:text-3xl font-mono uppercase tracking-wide text-white group-hover:text-neutral-300 transition-colors leading-snug m-0">
                      {entry.title}
                    </h2>

                    {entry.excerpt && (
                      <p class="text-sm sm:text-base text-neutral-300 font-sans leading-relaxed line-clamp-3 m-0">
                        {entry.excerpt}
                      </p>
                    )}

                    <div class="pt-1 text-xs font-mono uppercase tracking-widest text-neutral-400 group-hover:text-white transition-colors flex items-center gap-2">
                      <span>View Post</span>
                      <span class="transition-transform duration-300 group-hover:translate-x-1.5">&rarr;</span>
                    </div>
                  </div>

                  {entry.image && (
                    <div class="w-full md:w-1/2 flex-shrink-0 flex items-center justify-center select-none">
                      <div class="relative inline-flex overflow-hidden rounded-xl bg-transparent border-0 shadow-none justify-center items-center max-w-full">
                        <div class="absolute inset-0 pointer-events-none z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 crt-screen-vignette rounded-xl"></div>
                        <div class="absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 crt-scanlines rounded-xl"></div>
                        <img
                          src={entry.image}
                          alt={entry.title}
                          loading="lazy"
                          class={`block w-auto h-auto max-w-full object-contain rounded-xl transition-transform duration-500 ease-out group-hover:scale-[1.02] ${
                            entry.orientation === 'portrait' ? 'max-h-[500px]' : 'max-h-[380px]'
                          }`}
                        />
                      </div>
                    </div>
                  )}
                </a>
              </article>
            );
          })}

          {feed.length === 0 && (
            <div class="py-20 text-center text-xs font-mono uppercase tracking-[0.25em] text-neutral-500">
              [ No entries cataloged ][cite: 18]
            </div>
          )}
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<script>
  function setupIndexInteractions() {
    const featuredCard = document.getElementById('featured-post');
    const featuredLink = featuredCard?.querySelector('a');
    const featuredImg = featuredCard?.querySelector('img');
    const featuredImgContainer = featuredCard?.querySelector('.featured-img-container');
    const featuredContent = featuredCard?.querySelector('.featured-content-container');

    if (featuredLink && featuredImg && featuredImgContainer && featuredContent) {
      const adjustFeaturedLayout = () => {
        const isImgVertical = featuredImg.naturalHeight > featuredImg.naturalWidth;
        if (isImgVertical) {
          featuredLink.classList.remove('flex-col', 'items-center', 'text-center');
          featuredLink.classList.add('flex-col', 'md:flex-row', 'items-center', 'gap-8', 'md:gap-14');
          featuredImgContainer.classList.remove('w-full');
          featuredImgContainer.classList.add('w-full', 'md:w-1/2', 'flex-shrink-0');
          featuredContent.classList.remove('items-center', 'text-center', 'max-w-3xl');
          featuredContent.classList.add('text-left');
          featuredImg.classList.remove('max-h-[520px]');
          featuredImg.classList.add('max-h-[650px]');
        } else {
          featuredLink.classList.remove('md:flex-row', 'md:gap-14');
          featuredLink.classList.add('flex-col', 'items-center', 'gap-8', 'text-center');
          featuredImgContainer.classList.remove('md:w-1/2', 'flex-shrink-0');
          featuredImgContainer.classList.add('w-full');
          featuredContent.classList.remove('text-left');
          featuredContent.classList.add('items-center', 'text-center', 'max-w-3xl');
          featuredImg.classList.remove('max-h-[650px]');
          featuredImg.classList.add('max-h-[520px]');
        }
      };

      if (featuredImg.complete && featuredImg.naturalWidth > 0) {
        adjustFeaturedLayout();
      } else {
        featuredImg.addEventListener('load', adjustFeaturedLayout);
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('.glitch-reveal-item').forEach((item) => observer.observe(item));
  }

  document.addEventListener('astro:page-load', setupIndexInteractions);
</script>

<style>
  .dot-bg {
    background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 20px 20px;
    background-position: center top;
  }

  .crt-screen-vignette {
    box-shadow: inset 0 0 32px rgba(0, 0, 0, 0.85), inset 0 0 10px rgba(0, 0, 0, 0.95);
  }

  .crt-scanlines {
    background: linear-gradient(
      rgba(18, 16, 16, 0) 50%, 
      rgba(0, 0, 0, 0.45) 50%
    );
    background-size: 100% 4px;
  }

  .glitch-title {
    position: relative;
    display: inline-block;
    font-size: clamp(2.5rem, 11vw, 10rem);
    letter-spacing: 0.06em;
    max-width: 100%;
    word-break: normal;
    white-space: nowrap;
    cursor: default;
    color: #ffffff !important;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
  }

  .glitch-title::before, .glitch-title::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    pointer-events: none;
  }

  .glitch-title::before {
    left: 2px;
    text-shadow: -2px 0 #a3a3a3, 1px 0 #e5e5e5;
    clip-path: inset(0 0 100% 0);
    animation: tv-static-glitch-1 3.2s infinite linear alternate-reverse;
  }

  .glitch-title::after {
    left: -2px;
    text-shadow: 2px 0 #ffffff, -1px 0 #d4d4d4;
    clip-path: inset(0 0 100% 0);
    animation: tv-static-glitch-2 2.6s infinite linear alternate-reverse;
  }

  @keyframes tv-static-glitch-1 {
    0%, 80%, 100% { clip-path: inset(0 0 100% 0); transform: translate(0); opacity: 0.9; }
    82% { clip-path: inset(20% 0 50% 0); transform: translate(-3px, 1px); opacity: 0.75; }
    86% { clip-path: inset(60% 0 15% 0); transform: translate(3px, -1px); opacity: 0.85; }
    90% { clip-path: inset(10% 0 70% 0); transform: translate(-2px, 2px); opacity: 0.6; }
    95% { clip-path: inset(75% 0 8% 0); transform: translate(2px, -2px); opacity: 0.9; }
  }

  @keyframes tv-static-glitch-2 {
    0%, 75%, 100% { clip-path: inset(0 0 100% 0); transform: translate(0); opacity: 0.9; }
    78% { clip-path: inset(40% 0 35% 0); transform: translate(4px, -1px); opacity: 0.7; }
    83% { clip-path: inset(12% 0 72% 0); transform: translate(-3px, 1px); opacity: 0.8; }
    88% { clip-path: inset(68% 0 12% 0); transform: translate(2px, -2px); opacity: 0.65; }
    93% { clip-path: inset(25% 0 60% 0); transform: translate(-2px, 1px); opacity: 0.85; }
  }

  .glitch-reveal-item {
    opacity: 0;
    transform: translateY(24px);
    will-change: opacity, transform, filter;
  }

  .glitch-reveal-item.is-visible {
    animation: static-glitch-reveal 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes static-glitch-reveal {
    0% { opacity: 0; transform: translateY(24px); filter: blur(4px) contrast(150%); }
    20% { opacity: 0.4; transform: translateY(16px); filter: blur(2px) grayscale(100%); }
    40% { opacity: 0.7; transform: translateY(8px); filter: blur(1px); }
    60% { opacity: 0.9; transform: translateY(2px); filter: blur(0px); }
    100% { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in { 
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; 
  }
</style>