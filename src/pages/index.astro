---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('field_notes');

const sortedPosts = allPosts
  .filter((post) => post.data && post.data.isDraft !== true)
  .sort((a, b) => {
    const timeA = new Date(a.data.date).getTime();
    const timeB = new Date(b.data.date).getTime();
    return (isNaN(timeB) ? 0 : timeB) - (isNaN(timeA) ? 0 : timeA);
  });

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": sortedPosts.map((post, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://darlalovly.com/posts/${post.id}`,
    "name": post.data.title
  }))
};
---

<BaseLayout title="darlalovly | Daily Notes & Sights">
  <div class="columns-1 gap-4 sm:columns-2 lg:columns-3 sm:gap-6 py-4">
    {sortedPosts.map((post, index) => (
      <a
        href={`/posts/${post.id}`}
        class="group relative mb-4 block break-inside-avoid overflow-hidden rounded-xl bg-neutral-900 sm:mb-6"
      >
        <img
          src={post.data.image}
          alt={post.data.title}
          class="h-auto w-full object-cover transition-all duration-500 group-hover:scale-105 group-hover:brightness-75"
          loading={index < 3 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : "auto"}
          decoding="async"
        />
        <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 p-5 z-10">
          <h2 class="text-lg font-semibold !text-white leading-snug drop-shadow-lg">
            {post.data.title}
          </h2>
        </div>
      </a>
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</BaseLayout>