---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('field_notes');
const sortedPosts = posts
  .filter((post) => !post.data.isDraft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const siteUrl = Astro.site ? Astro.site.href : 'https://darlalovly.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<BaseLayout title="Field Notes — darlalovly" canonicalURL={canonicalURL}>
  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="columns-1 gap-6 sm:columns-2 lg:columns-3">
      {sortedPosts.map((post) => {
        const slug = post.id.replace(/\.mdx?$/, '');
        return (
          <article class="group relative mb-6 break-inside-avoid overflow-hidden rounded-xl shadow-sm transition-all duration-300 hover:shadow-lg">
            <a href={`/posts/${slug}`} class="relative block w-full">
              {post.data.image ? (
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="h-auto w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="h-48 w-full bg-neutral-800" />
              )}
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
              <div class="pointer-events-none absolute bottom-0 left-0 right-0 z-10 p-5 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                <h2 class="text-xl font-bold leading-snug !text-white">
                  {post.data.title}
                </h2>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>