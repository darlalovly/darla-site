---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('field_notes');
const sortedPosts = posts
  .filter((post) => !post.data.isDraft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const siteUrl = Astro.site ? Astro.site.href : 'https://darlalovly.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<BaseLayout title="Field Notes — darlalovly" canonicalURL={canonicalURL}>
  <main class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-10 border-b border-neutral-200 pb-6 text-center dark:border-neutral-800">
      <h1 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-4xl">
        Field Notes
      </h1>
    </header>

    <div class="flex flex-col space-y-12">
      {sortedPosts.map((post) => {
        const slug = post.id.replace(/\.mdx?$/, '');
        return (
          <article class="group flex flex-col space-y-4 border-b border-neutral-200 pb-10 dark:border-neutral-800">
            {post.data.image && (
              <a 
                href={`/posts/${slug}`} 
                class="block overflow-hidden rounded-xl border border-neutral-200 shadow-sm transition-all duration-200 group-hover:opacity-90 dark:border-neutral-800"
              >
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="h-auto w-full object-cover"
                  loading="lazy"
                />
              </a>
            )}
            
            <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-neutral-500">
              <time datetime={new Date(post.data.date).toISOString()}>
                {new Date(post.data.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  timeZone: 'UTC'
                })}
              </time>
              {post.data.location && (
                <>
                  <span>•</span>
                  <span>{post.data.location}</span>
                </>
              )}
            </div>

            <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
              <a href={`/posts/${slug}`} class="hover:underline">
                {post.data.title}
              </a>
            </h2>

            {post.data.description && (
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                {post.data.description}
              </p>
            )}
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>