    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.5fr auto;
    gap: 10px;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .recipe-gallery-row {
      grid-template-columns: 1fr;
    }
  }

  .gallery-del-wrap {
    display: flex;
    align-items: flex-end;
    padding-bottom: 4px;
  }

  .card-thumb-preview-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 8px 0;
  }

  .card-thumb-preview-box {
    width: 76px;
    height: 76px;
    min-width: 76px;
    min-height: 76px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-family: var(--font-title);
    letter-spacing: var(--caps-track);
    color: var(--text-2);
  }

  .card-thumb-round-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .status-banner {
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    font-family: var(--font-title);
    font-size: 11px;
    letter-spacing: var(--caps-track);
    text-transform: uppercase;
  }

  .status-success {
    background: #f4f4f5;
    color: #000000;
    border: 1px solid var(--border);
  }

  .status-info {
    background: #ffffff;
    color: var(--text-2);
    border: var(--dash);
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal-box {
    background: var(--bg-card);
    width: 100%;
    max-width: 840px;
    max-height: 85vh;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: #fafafa;
  }

  .modal-search-bar {
    padding: 12px 16px;
    background: #fafafa;
    border-bottom: 1px solid var(--border);
  }

  .modal-body {
    padding: 16px;
    overflow-y: auto;
  }

  .modal-media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 12px;
  }

  .media-choice-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 6px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    text-align: center;
    transition: border-color 120ms ease;
  }

  .media-choice-btn:hover {
    border-color: #000000;
  }

  .modal-thumb-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 2px;
  }
</style>