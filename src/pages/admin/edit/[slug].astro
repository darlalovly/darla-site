---
// File: src/pages/admin/edit/[slug].astro

import AdminLayout from '../../../layouts/AdminLayout.astro';
import '../../../styles/admin.css';
import { getCollection } from 'astro:content';

export const prerender = false;

const { slug } = Astro.params;
const typeParam = (Astro.url.searchParams.get('type') || '').toLowerCase();

let targetEntry: any = null;
let entryType: 'RECIPE' | 'POST' = 'POST';

if (typeParam === 'recipe') {
  const recipes = await getCollection('recipes');
  targetEntry = recipes.find((r) => r.id.replace(/\.(md|mdx)$/, '') === slug);
  if (targetEntry) entryType = 'RECIPE';
}

if (!targetEntry && typeParam !== 'recipe') {
  const posts = await getCollection('posts');
  targetEntry = posts.find((p) => p.id.replace(/\.(md|mdx)$/, '') === slug);
  if (targetEntry) entryType = 'POST';
}

if (!targetEntry) {
  const recipes = await getCollection('recipes');
  targetEntry = recipes.find((r) => r.id.replace(/\.(md|mdx)$/, '') === slug);
  if (targetEntry) entryType = 'RECIPE';
}

if (!targetEntry) {
  const posts = await getCollection('posts');
  targetEntry = posts.find((p) => p.id.replace(/\.(md|mdx)$/, '') === slug);
  if (targetEntry) entryType = 'POST';
}

if (!targetEntry) {
  return Astro.redirect('/admin');
}

const data = targetEntry.data || {};
const title = data.title || data.recipeName || '';
const recipeName = data.recipeName || '';
const description = data.description || data.excerpt || data.recipeExcerpt || '';
const recipeExcerpt = data.recipeExcerpt || '';
const recipeIngredients = data.recipeIngredients || '';
const recipeInstructions = data.recipeInstructions || '';
const recipeNotes = data.recipeNotes || '';
const prepTime = data.prepTime || '';
const cookTime = data.cookTime || '';
const servings = data.servings ? String(data.servings) : '';
const spices = data.spices || '';
const dateIso = data.date ? new Date(data.date).toISOString().slice(0, 16) : new Date().toISOString().slice(0, 16);
const category = (data.category || (entryType === 'RECIPE' ? 'recipes' : 'sights')).toLowerCase();
const location = data.location || '';
const isDraft = Boolean(data.isDraft || data.draft);
const heroImage = data.thumbnailKey || data.image || '';
const cardThumbnail = data.cardThumbnail || data.recipeThumb || '';
const heroOrientation = data.heroOrientation || data.orientation || 'landscape';
const heroPosition = data.heroPosition || (data.showHeroImage === false ? 'none' : 'top');
const moodString = Array.isArray(data.mood) ? data.mood.join(', ') : (data.mood || '');
const tagsString = Array.isArray(data.tags) ? data.tags.join(', ') : (data.tags || '');

const seoTitle = data.seoTitle || '';
const seoDescription = data.seoDescription || '';
const seoFocusKeyword = data.seoFocusKeyword || '';
const seoNoIndex = Boolean(data.seoNoIndex);

const locationsList = Array.isArray(data.locations) ? data.locations : [];
const galleryList = Array.isArray(data.gallery)
  ? data.gallery.map((g: any) => {
      if (typeof g === 'string') return { key: g, caption: '', date: '' };
      return {
        key: g.key || g.src || '',
        caption: g.caption || g.alt || '',
        date: g.date ? (typeof g.date === 'string' ? g.date.slice(0, 10) : new Date(g.date).toISOString().slice(0, 10)) : '',
      };
    })
  : [];

const rawBody = targetEntry.body || '';

const cloudflareBase = import.meta.env.PUBLIC_R2_URL || "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/";
const cleanBase = cloudflareBase.endsWith('/') ? cloudflareBase : `${cloudflareBase}/`;

const allPosts = await getCollection('posts');
const allRecipes = await getCollection('recipes');
const collectedImages: { url: string; key: string; source: string }[] = [];

allPosts.forEach((post) => {
  const k = post.data.thumbnailKey || post.data.image;
  if (k) {
    const cleanK = k.replace(/^\/+/, '');
    collectedImages.push({
      url: k.startsWith('http') ? k : `${cleanBase}${cleanK}`,
      key: cleanK,
      source: post.data.title || post.id,
    });
  }
  if (Array.isArray(post.data.gallery)) {
    post.data.gallery.forEach((g: any) => {
      const itemKey = typeof g === 'string' ? g : (g?.src || g?.key);
      if (itemKey) {
        const cleanK = itemKey.replace(/^\/+/, '');
        collectedImages.push({
          url: itemKey.startsWith('http') ? itemKey : `${cleanBase}${cleanK}`,
          key: cleanK,
          source: post.data.title || post.id,
        });
      }
    });
  }
});

allRecipes.forEach((recipe) => {
  const heroKey = recipe.data.thumbnailKey || recipe.data.image;
  if (heroKey) {
    const cleanK = heroKey.replace(/^\/+/, '');
    collectedImages.push({
      url: heroKey.startsWith('http') ? heroKey : `${cleanBase}${cleanK}`,
      key: cleanK,
      source: recipe.data.recipeName || recipe.data.title || recipe.id,
    });
  }
  if (recipe.data.cardThumbnail) {
    const cleanK = recipe.data.cardThumbnail.replace(/^\/+/, '');
    collectedImages.push({
      url: cleanK.startsWith('http') ? cleanK : `${cleanBase}${cleanK}`,
      key: cleanK,
      source: recipe.data.recipeName || recipe.data.title || recipe.id,
    });
  }
  if (Array.isArray(recipe.data.gallery)) {
    recipe.data.gallery.forEach((g: any) => {
      const itemKey = typeof g === 'string' ? g : (g?.src || g?.key);
      if (itemKey) {
        const cleanK = itemKey.replace(/^\/+/, '');
        collectedImages.push({
          url: itemKey.startsWith('http') ? itemKey : `${cleanBase}${cleanK}`,
          key: cleanK,
          source: recipe.data.recipeName || recipe.data.title || recipe.id,
        });
      }
    });
  }
});

const mediaAssets = Array.from(new Map(collectedImages.map((img) => [img.key, img])).values());
const categories = ['sights', 'food', 'events', 'musings', 'recipes'];
---

<AdminLayout title={`Edit ${title} ‹ darlalovly Studio`}>
  <div class="studio-wrapper">
    
    <header class="studio-header-bar">
      <div class="header-left">
        <h1 class="studio-page-title">EDIT {entryType}</h1>
        <a href="/admin" class="btn btn-secondary btn-sm" style="margin-left: 12px;">&larr; ALL ENTRIES</a>
      </div>
      <div class="header-right btn-group">
        <button type="button" id="btn-copy-md" class="btn btn-secondary btn-sm">COPY MD</button>
        <button type="button" id="btn-download-md" class="btn btn-secondary btn-sm">DOWNLOAD .MD</button>
        <button type="button" id="top-publish-btn" class="btn btn-primary btn-sm">UPDATE FILE</button>
      </div>
    </header>

    <div id="status-banner" class="status-banner" style="display: none;"></div>

    <form id="editor-form" class="studio-grid" onsubmit="return false;">
      
      <!-- Main Content Column -->
      <main class="studio-main-col">
        
        <div class="studio-card title-card">
          <input
            id="entry-title"
            type="text"
            required
            placeholder="ADD TITLE"
            value={title}
            class="input-title"
          />
          <div class="permalink-bar">
            <span class="permalink-label">PERMALINK: https://darlalovly.com/{entryType === 'RECIPE' ? 'recipes' : 'posts'}/</span>
            <input
              id="entry-slug"
              type="text"
              required
              value={slug}
              class="input-slug font-mono"
            />
          </div>
        </div>

        {entryType === 'RECIPE' && (
          <div class="studio-card">
            <div class="card-header">
              <span class="card-title">RECIPE DETAILS</span>
              <span class="card-subtitle">DISPLAY TITLE & EXCERPT</span>
            </div>
            <div class="card-body side-fields">
              <div class="form-row">
                <label for="recipeName" class="field-label">RECIPE DISPLAY NAME</label>
                <input
                  type="text"
                  id="recipeName"
                  value={recipeName}
                  placeholder="e.g. Southern Buttermilk Biscuits"
                  class="input-control"
                />
              </div>

              <div class="form-row">
                <label for="recipeExcerpt" class="field-label">RECIPE EXCERPT / DECK</label>
                <textarea
                  id="recipeExcerpt"
                  rows="3"
                  placeholder="Warm, buttery bites coated in cinnamon-sugar..."
                  class="input-textarea"
                >{recipeExcerpt}</textarea>
              </div>
            </div>
          </div>
        )}

        {entryType === 'RECIPE' && (
          <div class="studio-card">
            <div class="card-header">
              <span class="card-title">RECIPE CARD CONTENT</span>
              <span class="card-subtitle">INGREDIENTS & INSTRUCTIONS</span>
            </div>
            <div class="card-body side-fields">
              <div class="form-row">
                <label for="recipeIngredients" class="field-label">INGREDIENTS (ONE PER LINE; USE **HEADER:** FOR GROUPS)</label>
                <textarea
                  id="recipeIngredients"
                  rows="8"
                  placeholder="**The Fruit & Herb Base:**&#10;½ ripe mango&#10;8 fresh mint leaves"
                  class="input-textarea font-mono"
                >{recipeIngredients}</textarea>
              </div>

              <div class="form-row">
                <label for="recipeInstructions" class="field-label">INSTRUCTIONS (ONE PER LINE; USE **STEP TITLE:** TO BOLD)</label>
                <textarea
                  id="recipeInstructions"
                  rows="8"
                  placeholder="**Muddle:** Place the mango chunks and mint leaves in a glass.&#10;**Shake:** Add white rum."
                  class="input-textarea font-mono"
                >{recipeInstructions}</textarea>
              </div>

              <div class="form-row">
                <label for="recipeNotes" class="field-label">KITCHEN NOTES & ADAPTATIONS</label>
                <textarea
                  id="recipeNotes"
                  rows="4"
                  placeholder="**Temperature:** Keep butter cold for flakiest layers."
                  class="input-textarea font-mono"
                >{recipeNotes}</textarea>
              </div>
            </div>
          </div>
        )}

        <div class="studio-card">
          <div class="card-header">
            <span class="card-title">ENTRY NARRATIVE (MARKDOWN)</span>
            <span class="card-subtitle">RENDERED CLEANLY IN ARTICLE CANVAS</span>
          </div>
          <div class="card-body">
            <textarea
              id="entry-content"
              rows="16"
              placeholder="Write narrative Markdown..."
              class="input-textarea font-mono"
            >{rawBody}</textarea>
          </div>
        </div>

        {entryType === 'POST' && (
          <div class="studio-card">
            <div class="card-header">
              <span class="card-title">LOCATIONS & MAP PINS</span>
              <button id="add-pin-btn" type="button" class="btn btn-secondary btn-sm">
                + ADD LOCATION PIN
              </button>
            </div>
            <div class="card-body side-fields">
              <div id="pins-container" class="repeater-list">
                <p id="no-pins-notice" class="empty-notice" style={locationsList.length > 0 ? "display: none;" : ""}>
                  No locations added yet. Click "+ ADD LOCATION PIN" to attach Google Maps pins.
                </p>
                {locationsList.map((loc: any) => (
                  <div class="repeater-row pin-row">
                    <input type="text" placeholder="Place Name" value={loc.name || ''} class="pin-name input-control" />
                    <input type="text" placeholder="Address" value={loc.address || ''} class="pin-addr input-control" />
                    <div class="row-flex">
                      <input type="text" placeholder="Maps Link (URL)" value={loc.url || ''} class="pin-url input-control font-mono text-xs" />
                      <button type="button" class="del-row-btn btn-remove-pin" title="Remove">&times;</button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        <div class="studio-card">
          <div class="card-header">
            <span class="card-title">PHOTO GALLERY ARCHIVE</span>
            <div class="btn-group">
              <button id="btn-open-gallery-modal" type="button" class="btn btn-secondary btn-sm">
                CHOOSE FROM LIBRARY
              </button>
              <button id="btn-add-gallery-row" type="button" class="btn btn-secondary btn-sm">
                + ADD PHOTO
              </button>
            </div>
          </div>
          <div class="card-body side-fields">
            <p id="no-gallery-notice" class="empty-notice" style={galleryList.length > 0 ? "display: none;" : ""}>
              No gallery photos added yet. These render at the bottom of the entry in an archive layout.
            </p>
            <div id="gallery-container" class="repeater-list">
              {galleryList.map((item: any) => (
                <div class="recipe-gallery-row">
                  <div class="form-row">
                    <label class="field-label" style="font-size: 10px;">IMAGE KEY / FILENAME</label>
                    <input type="text" class="input-control font-mono text-xs g-key" value={item.key} placeholder="photo.webp" />
                  </div>
                  <div class="form-row">
                    <label class="field-label" style="font-size: 10px;">DATE TAKEN</label>
                    <input type="date" class="input-control font-mono text-xs g-date" value={item.date} />
                  </div>
                  <div class="form-row">
                    <label class="field-label" style="font-size: 10px;">CAPTION / NOTE</label>
                    <input type="text" class="input-control text-xs g-caption" value={item.caption} placeholder="Caption" />
                  </div>
                  <div class="gallery-del-wrap">
                    <button type="button" class="del-row-btn btn-remove-g" title="Remove">&times;</button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {entryType === 'RECIPE' && (
          <div class="studio-card">
            <div class="card-header">
              <span class="card-title">SEARCH ENGINE OPTIMIZATION (SEO)</span>
            </div>
            <div class="card-body side-fields">
              <div class="form-row">
                <label for="seoTitle" class="field-label">SEO TITLE</label>
                <input type="text" id="seoTitle" value={seoTitle} placeholder="Custom meta title" class="input-control" />
              </div>
              <div class="form-row">
                <label for="seoDescription" class="field-label">SEO META DESCRIPTION</label>
                <textarea id="seoDescription" rows="2" placeholder="Custom meta description" class="input-textarea">{seoDescription}</textarea>
              </div>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="form-row">
                  <label for="seoFocusKeyword" class="field-label">FOCUS KEYWORD</label>
                  <input type="text" id="seoFocusKeyword" value={seoFocusKeyword} placeholder="e.g. buttermilk biscuits" class="input-control" />
                </div>
                <div class="form-row" style="justify-content: flex-end; padding-bottom: 6px;">
                  <label class="category-item" style="font-size: 11px;">
                    <input type="checkbox" id="seoNoIndex" checked={seoNoIndex} value="true" />
                    <span>EXCLUDE FROM SEARCH ENGINES (NOINDEX)</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
        )}

      </main>

      <!-- Sidebar Column -->
      <aside class="studio-side-col">
        
        <div class="studio-card">
          <div class="card-header">
            <span class="card-title">PUBLISH</span>
          </div>
          <div class="card-body side-fields">
            <div class="form-row">
              <label class="field-label">STATUS:</label>
              <select id="isDraftSelect" class="input-select" style="width: 100%;">
                <option value="false" selected={!isDraft}>PUBLISHED</option>
                <option value="true" selected={isDraft}>DRAFT</option>
              </select>
            </div>

            <div class="form-row">
              <label for="entry-date" class="field-label">DATE & TIME:</label>
              <input
                id="entry-date"
                type="datetime-local"
                value={dateIso}
                class="input-control font-mono text-xs"
              />
            </div>

            {entryType === 'POST' && (
              <div class="form-row">
                <label for="post-general-location" class="field-label">CITY / STATE TAG:</label>
                <input
                  id="post-general-location"
                  type="text"
                  placeholder="e.g. Philadelphia, Pennsylvania"
                  value={location}
                  class="input-control"
                />
              </div>
            )}
          </div>
          <div class="card-footer">
            <button id="btn-copy-md-side" type="button" class="link-btn">
              COPY MD
            </button>
            <button id="side-publish-btn" type="button" class="btn btn-primary btn-sm">
              UPDATE FILE
            </button>
          </div>
        </div>

        {entryType === 'POST' && (
          <div class="studio-card">
            <div class="card-header">
              <span class="card-title">CATEGORY</span>
            </div>
            <div class="card-body">
              <div class="category-list">
                {categories.map((cat) => (
                  <label class="category-item">
                    <input
                      type="radio"
                      name="post-category"
                      value={cat}
                      checked={category === cat}
                    />
                    <span class="category-name">{cat.toUpperCase()}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>
        )}

        <div class="studio-card">
          <div class="card-header">
            <span class="card-title">FEATURED IMAGE</span>
            <button id="btn-open-hero-modal" type="button" class="btn btn-secondary btn-sm" style="font-size: 10px; padding: 2px 8px;">
              CHOOSE FROM LIBRARY
            </button>
          </div>
          <div class="card-body side-fields">
            <div class="form-row">
              <label for="thumbnailKey" class="field-label">IMAGE KEY / FILENAME</label>
              <input
                id="thumbnailKey"
                type="text"
                placeholder="header.webp"
                value={heroImage}
                class="input-control font-mono text-xs"
              />
            </div>

            <div class="form-row">
              <label for="heroOrientation" class="field-label">ORIENTATION</label>
              <select id="heroOrientation" class="input-select" style="width: 100%;">
                <option value="landscape" selected={heroOrientation === 'landscape'}>LANDSCAPE (16:9)</option>
                <option value="portrait" selected={heroOrientation === 'portrait'}>PORTRAIT</option>
                <option value="square" selected={heroOrientation === 'square'}>SQUARE</option>
              </select>
            </div>

            <div class="form-row">
              <label for="heroPosition" class="field-label">DISPLAY POSITION</label>
              <select id="heroPosition" class="input-select" style="width: 100%;">
                <option value="top" selected={heroPosition === 'top'}>TOP CENTER (ABOVE TEXT)</option>
                <option value="left" selected={heroPosition === 'left'}>LEFT (WRAP TEXT)</option>
                <option value="right" selected={heroPosition === 'right'}>RIGHT (WRAP TEXT)</option>
                <option value="none" selected={heroPosition === 'none'}>DO NOT DISPLAY IN POST</option>
              </select>
            </div>

            <div id="hero-preview-box" class="hero-preview-box mt-2">
              <span>NO IMAGE SELECTED</span>
            </div>
          </div>
        </div>

        {entryType === 'RECIPE' && (
          <div class="studio-card">
            <div class="card-header">
              <span class="card-title">CARD THUMBNAIL</span>
              <button id="btn-open-card-thumb-modal" type="button" class="btn btn-secondary btn-sm" style="font-size: 10px; padding: 2px 8px;">
                CHOOSE FROM LIBRARY
              </button>
            </div>
            <div class="card-body side-fields">
              <div class="form-row">
                <label for="cardThumbnail" class="field-label">ROUND BADGE IMAGE (FALLS BACK TO FEATURED)</label>
                <input
                  id="cardThumbnail"
                  type="text"
                  placeholder="e.g. mango-glass.webp"
                  value={cardThumbnail}
                  class="input-control font-mono text-xs"
                />
              </div>

              <div class="card-thumb-preview-wrapper mt-2">
                <div id="card-thumb-preview-box" class="card-thumb-preview-box">
                  <span>FALLBACK</span>
                </div>
              </div>
            </div>
          </div>
        )}

        {entryType === 'RECIPE' && (
          <div class="studio-card">
            <div class="card-header">
              <span class="card-title">TIMING & PARAMETERS</span>
            </div>
            <div class="card-body side-fields">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="form-row">
                  <label for="prepTime" class="field-label">PREP TIME</label>
                  <input type="text" id="prepTime" value={prepTime} placeholder="e.g. 20 min" class="input-control" />
                </div>
                <div class="form-row">
                  <label for="cookTime" class="field-label">COOK TIME</label>
                  <input type="text" id="cookTime" value={cookTime} placeholder="e.g. 45 min" class="input-control" />
                </div>
              </div>

              <div class="form-row">
                <label for="servings" class="field-label">SERVINGS</label>
                <input type="text" id="servings" value={servings} placeholder="e.g. 8" class="input-control" />
              </div>

              <div class="form-row">
                <label for="spices" class="field-label">SPICES</label>
                <input type="text" id="spices" value={spices} placeholder="e.g. cinnamon, cardamom" class="input-control" />
              </div>

              <div class="form-row">
                <label for="tags" class="field-label">TAGS (COMMA SEPARATED)</label>
                <input type="text" id="tags" value={tagsString} placeholder="cocktail, summer, drink" class="input-control" />
              </div>
            </div>
          </div>
        )}

        {entryType === 'POST' && (
          <div class="studio-card">
            <div class="card-header">
              <span class="card-title">MOOD & TAGS</span>
            </div>
            <div class="card-body side-fields">
              <div class="form-row">
                <label for="post-mood" class="field-label">MOOD (COMMA SEPARATED)</label>
                <input
                  id="post-mood"
                  type="text"
                  value={moodString}
                  placeholder="observant, excited"
                  class="input-control"
                />
              </div>
              <div class="form-row">
                <label for="post-tags" class="field-label">TAGS (COMMA SEPARATED)</label>
                <input
                  id="post-tags"
                  type="text"
                  value={tagsString}
                  placeholder="architecture, sights"
                  class="input-control"
                />
              </div>
            </div>
          </div>
        )}

        {entryType === 'POST' && (
          <div class="studio-card">
            <div class="card-header">
              <span class="card-title">EXCERPT / META DESCRIPTION</span>
            </div>
            <div class="card-body">
              <textarea
                id="post-desc"
                rows="3"
                placeholder="Short summary for social previews..."
                class="input-textarea"
              >{description}</textarea>
            </div>
          </div>
        )}

      </aside>

    </form>
  </div>

  <!-- Media Library Modal -->
  <div id="media-modal-backdrop" class="modal-backdrop" style="display: none;">
    <div class="modal-box">
      <div class="modal-header">
        <h3 class="card-title" id="modal-title">SELECT R2 MEDIA ASSET</h3>
        <button id="close-modal-btn" type="button" class="del-row-btn" style="font-size: 20px;">&times;</button>
      </div>
      <div class="modal-search-bar">
        <input
          id="modal-search-input"
          type="text"
          placeholder="Filter library by filename or source..."
          class="input-control font-mono text-xs"
        />
      </div>
      <div class="modal-body">
        <div id="modal-grid" class="modal-media-grid">
          {mediaAssets.map((asset) => (
            <button
              type="button"
              class="modal-asset-item media-choice-btn"
              data-key={asset.key}
              data-url={asset.url}
              data-search={`${asset.key} ${asset.source}`.toLowerCase()}
            >
              <img src={asset.url} alt={asset.key} loading="lazy" class="modal-thumb-img" />
              <span class="media-key" style="font-size: 9px;" title={asset.key}>{asset.key.split('/').pop()}</span>
            </button>
          ))}
          {mediaAssets.length === 0 && (
            <p class="empty-notice p-4 text-center">No indexed media found.</p>
          )}
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline define:vars={{ cleanBase, entryType }}>
  let activeImageTarget = 'hero';

  const titleInput = document.getElementById('entry-title');
  const slugInput = document.getElementById('entry-slug');
  const dateInput = document.getElementById('entry-date');
  const statusSelect = document.getElementById('isDraftSelect');
  const heroInput = document.getElementById('thumbnailKey');
  const heroOrientationSelect = document.getElementById('heroOrientation');
  const heroPositionSelect = document.getElementById('heroPosition');
  const heroPreview = document.getElementById('hero-preview-box');
  const cardThumbInput = document.getElementById('cardThumbnail');
  const cardThumbPreview = document.getElementById('card-thumb-preview-box');
  const contentInput = document.getElementById('entry-content');
  const statusBanner = document.getElementById('status-banner');

  const galleryContainer = document.getElementById('gallery-container');
  const addGalleryBtn = document.getElementById('btn-add-gallery-row');
  const noGalleryNotice = document.getElementById('no-gallery-notice');

  const pinsContainer = document.getElementById('pins-container');
  const addPinBtn = document.getElementById('add-pin-btn');
  const noPinsNotice = document.getElementById('no-pins-notice');

  const topPublishBtn = document.getElementById('top-publish-btn');
  const sidePublishBtn = document.getElementById('side-publish-btn');
  const copyMdBtn = document.getElementById('btn-copy-md');
  const copyMdSideBtn = document.getElementById('btn-copy-md-side');
  const downloadMdBtn = document.getElementById('btn-download-md');

  const modalBackdrop = document.getElementById('media-modal-backdrop');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const modalSearchInput = document.getElementById('modal-search-input');
  const modalAssetItems = document.querySelectorAll('.modal-asset-item');
  const openHeroModalBtn = document.getElementById('btn-open-hero-modal');
  const openGalleryModalBtn = document.getElementById('btn-open-gallery-modal');
  const openCardThumbModalBtn = document.getElementById('btn-open-card-thumb-modal');

  function resolveFullUrl(val) {
    if (!val) return '';
    if (val.startsWith('http://') || val.startsWith('https://')) return val;
    if (val.startsWith('images/')) return cleanBase + val;
    const folder = entryType === 'RECIPE' ? 'recipes' : 'posts';
    return cleanBase + 'images/' + folder + '/' + (slugInput?.value || 'temp') + '/' + val.replace(/^\/+/, '');
  }

  function updateHeroPreview() {
    if (!heroInput || !heroPreview) return;
    const val = heroInput.value.trim();
    if (!val) {
      heroPreview.innerHTML = '<span>NO IMAGE SELECTED</span>';
    } else {
      const fullUrl = resolveFullUrl(val);
      const img = document.createElement('img');
      img.src = fullUrl;
      img.alt = 'Hero preview';
      img.className = 'preview-img';
      img.onerror = () => {
        heroPreview.innerHTML = '<span>IMAGE NOT FOUND</span>';
      };
      heroPreview.innerHTML = '';
      heroPreview.appendChild(img);
    }
    updateCardThumbPreview();
  }

  function updateCardThumbPreview() {
    if (!cardThumbPreview) return;
    const specificVal = cardThumbInput?.value.trim();
    const effectiveVal = specificVal || heroInput?.value.trim();

    if (!effectiveVal) {
      cardThumbPreview.innerHTML = '<span>NONE</span>';
      return;
    }

    const fullUrl = resolveFullUrl(effectiveVal);
    const img = document.createElement('img');
    img.src = fullUrl;
    img.alt = 'Card thumb preview';
    img.className = 'card-thumb-round-img';
    img.onerror = () => {
      cardThumbPreview.innerHTML = '<span>ERR</span>';
    };
    cardThumbPreview.innerHTML = '';
    cardThumbPreview.appendChild(img);
  }

  if (heroInput) heroInput.addEventListener('input', updateHeroPreview);
  if (cardThumbInput) cardThumbInput.addEventListener('input', updateCardThumbPreview);
  if (slugInput) {
    slugInput.addEventListener('input', () => {
      updateHeroPreview();
      updateCardThumbPreview();
    });
  }

  function bindRowEvents() {
    document.querySelectorAll('.btn-remove-g').forEach((btn) => {
      btn.onclick = () => {
        btn.closest('.recipe-gallery-row')?.remove();
        if (galleryContainer && galleryContainer.querySelectorAll('.recipe-gallery-row').length === 0 && noGalleryNotice) {
          noGalleryNotice.style.display = 'block';
        }
      };
    });

    document.querySelectorAll('.btn-remove-pin').forEach((btn) => {
      btn.onclick = () => {
        btn.closest('.pin-row')?.remove();
        if (pinsContainer && pinsContainer.querySelectorAll('.pin-row').length === 0 && noPinsNotice) {
          noPinsNotice.style.display = 'block';
        }
      };
    });
  }
  bindRowEvents();

  function addGalleryRow(key = '', caption = '', date = '') {
    if (!galleryContainer) return;
    if (noGalleryNotice) noGalleryNotice.style.display = 'none';

    const row = document.createElement('div');
    row.className = 'recipe-gallery-row';
    row.innerHTML = 
      '<div class="form-row">' +
        '<label class="field-label" style="font-size: 10px;">IMAGE KEY / FILENAME</label>' +
        '<input type="text" class="input-control font-mono text-xs g-key" value="' + key + '" placeholder="photo.webp" />' +
      '</div>' +
      '<div class="form-row">' +
        '<label class="field-label" style="font-size: 10px;">DATE TAKEN</label>' +
        '<input type="date" class="input-control font-mono text-xs g-date" value="' + date + '" />' +
      '</div>' +
      '<div class="form-row">' +
        '<label class="field-label" style="font-size: 10px;">CAPTION / NOTE</label>' +
        '<input type="text" class="input-control text-xs g-caption" value="' + caption + '" placeholder="Caption" />' +
      '</div>' +
      '<div class="gallery-del-wrap">' +
        '<button type="button" class="del-row-btn btn-remove-g" title="Remove">&times;</button>' +
      '</div>';
    galleryContainer.appendChild(row);
    bindRowEvents();
  }

  function addPinRow(name = '', address = '', url = '') {
    if (!pinsContainer) return;
    if (noPinsNotice) noPinsNotice.style.display = 'none';

    const row = document.createElement('div');
    row.className = 'repeater-row pin-row';
    row.innerHTML = 
      '<input type="text" placeholder="Place Name" value="' + name + '" class="pin-name input-control" />' +
      '<input type="text" placeholder="Address" value="' + address + '" class="pin-addr input-control" />' +
      '<div class="row-flex">' +
        '<input type="text" placeholder="Maps Link (URL)" value="' + url + '" class="pin-url input-control font-mono text-xs" />' +
        '<button type="button" class="del-row-btn btn-remove-pin" title="Remove">&times;</button>' +
      '</div>';
    pinsContainer.appendChild(row);
    bindRowEvents();
  }

  if (addGalleryBtn) addGalleryBtn.onclick = () => addGalleryRow();
  if (addPinBtn) addPinBtn.onclick = () => addPinRow();

  function openModal(mode) {
    activeImageTarget = mode;
    if (modalSearchInput) modalSearchInput.value = '';
    modalAssetItems.forEach((btn) => (btn.style.display = ''));
    if (modalBackdrop) modalBackdrop.style.display = 'flex';
  }

  function closeModal() {
    if (modalBackdrop) modalBackdrop.style.display = 'none';
  }

  if (openHeroModalBtn) openHeroModalBtn.onclick = () => openModal('hero');
  if (openGalleryModalBtn) openGalleryModalBtn.onclick = () => openModal('gallery');
  if (openCardThumbModalBtn) openCardThumbModalBtn.onclick = () => openModal('cardThumb');
  if (closeModalBtn) closeModalBtn.onclick = closeModal;

  if (modalBackdrop) {
    modalBackdrop.onclick = (e) => {
      if (e.target === modalBackdrop) closeModal();
    };
  }

  if (modalSearchInput) {
    modalSearchInput.addEventListener('input', () => {
      const q = modalSearchInput.value.toLowerCase().trim();
      modalAssetItems.forEach((btn) => {
        const corpus = btn.getAttribute('data-search') || '';
        btn.style.display = !q || corpus.includes(q) ? '' : 'none';
      });
    });
  }

  modalAssetItems.forEach((btn) => {
    btn.onclick = () => {
      const key = btn.getAttribute('data-key') || '';
      if (activeImageTarget === 'hero') {
        if (heroInput) {
          heroInput.value = key;
          updateHeroPreview();
        }
      } else if (activeImageTarget === 'cardThumb') {
        if (cardThumbInput) {
          cardThumbInput.value = key;
          updateCardThumbPreview();
        }
      } else if (activeImageTarget === 'gallery') {
        addGalleryRow(key);
      }
      closeModal();
    };
  });

  function buildMarkdownString() {
    const titleVal = titleInput?.value.trim() || 'Untitled';
    const slugVal = slugInput?.value.trim() || 'untitled';
    const dateVal = dateInput?.value ? new Date(dateInput.value).toISOString() : new Date().toISOString();
    const isDraftVal = statusSelect?.value === 'true';
    const heroVal = heroInput?.value.trim() || '';
    const orientationVal = heroOrientationSelect?.value || 'landscape';
    const heroPositionVal = heroPositionSelect ? heroPositionSelect.value : 'top';
    const showHeroVal = heroPositionVal !== 'none';
    const bodyVal = contentInput?.value.trim() || '';

    const gallery = [];
    document.querySelectorAll('#gallery-container .recipe-gallery-row').forEach((row) => {
      const key = row.querySelector('.g-key')?.value.trim();
      const date = row.querySelector('.g-date')?.value.trim();
      const caption = row.querySelector('.g-caption')?.value.trim();
      if (key) {
        if (date || caption) {
          gallery.push({ key, ...(date ? { date } : {}), ...(caption ? { caption } : {}) });
        } else {
          gallery.push(key);
        }
      }
    });

    if (entryType === 'RECIPE') {
      const recipeNameVal = document.getElementById('recipeName')?.value.trim();
      const cardThumbVal = cardThumbInput?.value.trim();
      const prepVal = document.getElementById('prepTime')?.value.trim();
      const cookVal = document.getElementById('cookTime')?.value.trim();
      const servingsVal = document.getElementById('servings')?.value.trim();
      const spicesVal = document.getElementById('spices')?.value.trim();
      const tagsVal = document.getElementById('tags')?.value.split(',').map((t) => t.trim()).filter(Boolean) || [];
      const excerptVal = document.getElementById('recipeExcerpt')?.value.trim();
      const ingredientsVal = document.getElementById('recipeIngredients')?.value.trim();
      const instructionsVal = document.getElementById('recipeInstructions')?.value.trim();
      const notesVal = document.getElementById('recipeNotes')?.value.trim();
      const seoTitleVal = document.getElementById('seoTitle')?.value.trim();
      const seoDescVal = document.getElementById('seoDescription')?.value.trim();
      const seoFocusVal = document.getElementById('seoFocusKeyword')?.value.trim();
      const seoNoIndexVal = document.getElementById('seoNoIndex')?.checked;

      const lines = [
        '---',
        'title: ' + JSON.stringify(titleVal),
        ...(recipeNameVal ? ['recipeName: ' + JSON.stringify(recipeNameVal)] : []),
        'date: ' + JSON.stringify(dateVal),
        'isDraft: ' + isDraftVal,
        'heroOrientation: ' + JSON.stringify(orientationVal),
        'heroPosition: ' + JSON.stringify(heroPositionVal),
        'showHeroImage: ' + showHeroVal,
        ...(heroVal ? ['thumbnailKey: ' + JSON.stringify(heroVal)] : []),
        ...(cardThumbVal ? ['cardThumbnail: ' + JSON.stringify(cardThumbVal)] : []),
        ...(gallery.length > 0 ? [
          'gallery:',
          ...gallery.map((g) => typeof g === 'string' ? '  - ' + JSON.stringify(g) : '  - key: ' + JSON.stringify(g.key) + '\n' + (g.date ? '    date: ' + JSON.stringify(g.date) + '\n' : '') + (g.caption ? '    caption: ' + JSON.stringify(g.caption) : ''))
        ] : []),
        ...(prepVal ? ['prepTime: ' + JSON.stringify(prepVal)] : []),
        ...(cookVal ? ['cookTime: ' + JSON.stringify(cookVal)] : []),
        ...(servingsVal ? ['servings: ' + JSON.stringify(servingsVal)] : []),
        ...(spicesVal ? ['spices: ' + JSON.stringify(spicesVal)] : []),
        ...(tagsVal.length ? ['tags: ' + JSON.stringify(tagsVal)] : []),
        ...(excerptVal ? ['recipeExcerpt: |\n  ' + excerptVal.replace(/\n/g, '\n  ')] : []),
        ...(ingredientsVal ? ['recipeIngredients: |\n  ' + ingredientsVal.replace(/\n/g, '\n  ')] : []),
        ...(instructionsVal ? ['recipeInstructions: |\n  ' + instructionsVal.replace(/\n/g, '\n  ')] : []),
        ...(notesVal ? ['recipeNotes: |\n  ' + notesVal.replace(/\n/g, '\n  ')] : []),
        ...(seoTitleVal ? ['seoTitle: ' + JSON.stringify(seoTitleVal)] : []),
        ...(seoDescVal ? ['seoDescription: ' + JSON.stringify(seoDescVal)] : []),
        ...(seoFocusVal ? ['seoFocusKeyword: ' + JSON.stringify(seoFocusVal)] : []),
        ...(seoNoIndexVal ? ['seoNoIndex: true'] : []),
        '---',
        '',
        bodyVal,
      ];
      return {
        slug: slugVal,
        collection: 'recipes',
        content: lines.join('\n'),
        data: {
          title: titleVal,
          recipeName: recipeNameVal,
          date: dateVal,
          isDraft: isDraftVal,
          heroOrientation: orientationVal,
          heroPosition: heroPositionVal,
          showHeroImage: showHeroVal,
          thumbnailKey: heroVal,
          cardThumbnail: cardThumbVal,
          gallery: gallery,
          prepTime: prepVal,
          cookTime: cookVal,
          servings: servingsVal,
          spices: spicesVal,
          tags: tagsVal,
        }
      };
    } else {
      const catRadio = document.querySelector('input[name="post-category"]:checked');
      const catVal = catRadio?.value || 'sights';
      const locVal = document.getElementById('post-general-location')?.value.trim();
      const moodVal = document.getElementById('post-mood')?.value.split(',').map((m) => m.trim()).filter(Boolean) || [];
      const tagsVal = document.getElementById('post-tags')?.value.split(',').map((t) => t.trim()).filter(Boolean) || [];
      const descVal = document.getElementById('post-desc')?.value.trim();

      const pins = [];
      pinsContainer?.querySelectorAll('.pin-row').forEach((row) => {
        const name = row.querySelector('.pin-name')?.value.trim();
        const address = row.querySelector('.pin-addr')?.value.trim();
        const url = row.querySelector('.pin-url')?.value.trim();
        if (name || address) pins.push({ name, address, url });
      });

      const lines = [
        '---',
        'title: ' + JSON.stringify(titleVal),
        ...(descVal ? ['description: ' + JSON.stringify(descVal)] : []),
        'date: ' + JSON.stringify(dateVal),
        'category: ' + JSON.stringify(catVal),
        ...(locVal ? ['location: ' + JSON.stringify(locVal)] : []),
        ...(heroVal ? ['thumbnailKey: ' + JSON.stringify(heroVal)] : []),
        'heroOrientation: ' + JSON.stringify(orientationVal),
        'heroPosition: ' + JSON.stringify(heroPositionVal),
        'showHeroImage: ' + showHeroVal,
        'isDraft: ' + isDraftVal,
        ...(moodVal.length ? ['mood: ' + JSON.stringify(moodVal)] : []),
        ...(tagsVal.length ? ['tags: ' + JSON.stringify(tagsVal)] : []),
        ...(pins.length > 0 ? [
          'locations:',
          ...pins.map((p) => '  - name: ' + JSON.stringify(p.name) + '\n    address: ' + JSON.stringify(p.address || '') + '\n    url: ' + JSON.stringify(p.url || ''))
        ] : []),
        ...(gallery.length > 0 ? [
          'gallery:',
          ...gallery.map((g) => typeof g === 'string' ? '  - ' + JSON.stringify(g) : '  - key: ' + JSON.stringify(g.key) + '\n' + (g.date ? '    date: ' + JSON.stringify(g.date) + '\n' : '') + (g.caption ? '    caption: ' + JSON.stringify(g.caption) : ''))
        ] : []),
        '---',
        '',
        bodyVal,
      ];
      return {
        slug: slugVal,
        collection: 'posts',
        content: lines.join('\n'),
        data: {
          title: titleVal,
          description: descVal,
          date: dateVal,
          category: catVal,
          location: locVal,
          thumbnailKey: heroVal,
          heroOrientation: orientationVal,
          heroPosition: heroPositionVal,
          showHeroImage: showHeroVal,
          isDraft: isDraftVal,
          mood: moodVal,
          tags: tagsVal,
          locations: pins,
          gallery: gallery,
        }
      };
    }
  }

  function showStatus(msg, type) {
    if (!statusBanner) return;
    statusBanner.textContent = msg;
    statusBanner.className = 'status-banner status-' + type;
    statusBanner.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  const copyMdAction = async () => {
    const payload = buildMarkdownString();
    await navigator.clipboard.writeText(payload.content);
    showStatus('Markdown copied to clipboard!', 'success');
  };

  if (copyMdBtn) copyMdBtn.onclick = copyMdAction;
  if (copyMdSideBtn) copyMdSideBtn.onclick = copyMdAction;

  if (downloadMdBtn) {
    downloadMdBtn.onclick = () => {
      const payload = buildMarkdownString();
      const blob = new Blob([payload.content], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = payload.slug + '.md';
      a.click();
      URL.revokeObjectURL(url);
    };
  }

  async function handleUpdate() {
    const payload = buildMarkdownString();
    const btns = [topPublishBtn, sidePublishBtn].filter(Boolean);

    btns.forEach((b) => {
      b.disabled = true;
      b.textContent = 'SAVING...';
    });

    try {
      const res = await fetch('/admin/api/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          collection: payload.collection,
          slug: payload.slug,
          data: payload.data,
          content: payload.content,
          raw: payload.content,
        }),
      });

      const result = await res.json().catch(() => ({}));

      if (res.ok && (result.success !== false)) {
        if (result.mode === 'github-api') {
          showStatus('Committed ' + payload.slug + '.md to GitHub! Cloudflare deployment triggered.', 'success');
        } else if (result.mode === 'local-fs') {
          showStatus('Saved ' + payload.slug + '.md directly to disk!', 'success');
        } else {
          showStatus('Entry updated successfully!', 'success');
        }
        btns.forEach((b) => (b.textContent = 'UPDATED!'));
        setTimeout(() => btns.forEach((b) => (b.textContent = 'UPDATE FILE')), 2200);
      } else {
        const errorMsg = result.error || result.message || 'Save error occurred.';
        showStatus(errorMsg + ' (Direct .md download started as backup)', 'info');
        downloadMdBtn?.click();
      }
    } catch (e) {
      showStatus('Network connection error; downloaded backup .md file.', 'info');
      downloadMdBtn?.click();
    } finally {
      btns.forEach((b) => (b.disabled = false));
    }
  }

  if (topPublishBtn) topPublishBtn.onclick = handleUpdate;
  if (sidePublishBtn) sidePublishBtn.onclick = handleUpdate;

  updateHeroPreview();
</script>

<style is:global>
  .recipe-gallery-row {
