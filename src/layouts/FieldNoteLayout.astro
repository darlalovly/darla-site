---
import Layout from './Layout.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <main class="max-w-4xl mx-auto px-4 py-8 md:py-12">
    <article class="field-note-content prose prose-neutral max-w-none">
      <slot />
    </article>
  </main>
</Layout>

<style is:global>
  .field-note-content {
    width: 100%;
  }

  /* Reset default paragraph gaps */
  .field-note-content p {
    margin-top: 0 !important;
    margin-bottom: 0.75rem !important;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text);
  }

  .field-note-content p:last-child {
    margin-bottom: 0 !important;
  }

  /* Universal image bounds */
  .field-note-content img {
    margin: 0 !important;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--radius, 8px);
  }

  /* Two-column alternating row wrapper */
  .mosaic-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .mosaic-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Full-width stretch image wrapper */
  .mosaic-full {
    width: 100%;
    margin-bottom: 1rem;
  }

  .mosaic-full img {
    height: auto;
    max-height: 70vh;
  }

  /* Subtle card container for text blurbs */
  .mosaic-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.025);
    border-radius: var(--radius, 8px);
    height: 100%;
  }
</style>