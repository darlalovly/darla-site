---
interface Props {
  title?: string;
}

const { title = "darlalovly" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-neutral-800 antialiased">
    <slot />

    <script>
      document.addEventListener('contextmenu', async (e) => {
        const target = e.target as HTMLElement;
        if (target && target.tagName === 'IMG') {
          e.preventDefault();
          const img = target as HTMLImageElement;
          
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          if (!ctx) return;

          const tempImg = new Image();
          tempImg.crossOrigin = 'anonymous';
          tempImg.src = img.src;

          await new Promise((resolve) => {
            tempImg.onload = resolve;
          });

          canvas.width = tempImg.naturalWidth;
          canvas.height = tempImg.naturalHeight;

          ctx.drawImage(tempImg, 0, 0);

          const fontSize = Math.max(Math.round(canvas.width * 0.03), 16);
          const paddingX = Math.max(Math.round(canvas.width * 0.06), 35);
          const paddingY = Math.max(Math.round(canvas.height * 0.06), 35);

          ctx.font = `500 ${fontSize}px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace`;
          ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
          ctx.textAlign = 'end';
          ctx.fillText('darlalovly', canvas.width - paddingX, canvas.height - paddingY);

          canvas.toBlob((blob) => {
            if (!blob) return;
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = img.src.split('/').pop() || 'download.webp';
            a.click();
            URL.revokeObjectURL(url);
          }, 'image/webp');
        }
      });
    </script>
  </body>
</html>