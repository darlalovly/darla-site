---
// File: src/layouts/BaseLayout.astro

import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
  type?: 'website' | 'article';
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  author?: string;
  noindex?: boolean;
  enableAudioTransition?: boolean;
}

const { 
  title = "darlalovly", 
  description = "A personal digital garden of wanderings, unexpected detours, and visual archives.", 
  image = "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/branding/darlalovly-logo.webp",
  canonicalURL,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Darla',
  noindex = false,
  enableAudioTransition = false,
} = Astro.props;

const logoUrl = "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/branding/darlalovly-logo.webp";
---

<!doctype html>
<html lang="en">
  <head>
    <SEO 
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      noindex={noindex}
    />
    <ClientRouter />
    <link rel="icon" type="image/webp" href={logoUrl} />
    <link rel="alternate" type="application/rss+xml" title="darlalovly" href="/rss.xml" />
  </head>
  <body 
    data-audio-transitions={enableAudioTransition ? "true" : "false"}
    class="public-site selection:bg-white selection:text-neutral-900 bg-neutral-950 text-neutral-100 min-h-screen flex flex-col justify-between"
  >
    <!-- Fixed Analog Static Layer -->
    <div class="fixed inset-0 pointer-events-none z-50 animated-noise-overlay" aria-hidden="true"></div>

    <!-- Multi-Mode Analog & CRT Transition Overlay -->
    <div id="crt-off-overlay" class="fixed inset-0 pointer-events-none z-[100] opacity-0 flex items-center justify-center overflow-hidden" aria-hidden="true">
      <div class="crt-screen-flash absolute inset-0 bg-white opacity-0 pointer-events-none"></div>
      <div class="crt-static-burst absolute inset-0 pointer-events-none"></div>
      <div class="crt-collapse-line w-full pointer-events-none"></div>
      <div class="degauss-warp-mesh absolute inset-0 pointer-events-none"></div>
      <div class="tv-scanlines absolute inset-0 pointer-events-none"></div>
    </div>

    <!-- Modular Navigation Header -->
    <Header logoUrl={logoUrl} />

    <!-- Main Content Slot -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 flex flex-col">
      <slot />
    </main>

    <!-- Modular Footer -->
    <Footer siteName="darlalovly" />

    <script>
      import { navigate } from 'astro:transitions/client';

      class CRTTransitionAudio {
        ctx: AudioContext | null = null;

        init() {
          if (!this.ctx) {
            const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
            if (AudioCtx) this.ctx = new AudioCtx();
          }
          if (this.ctx && this.ctx.state === 'suspended') {
            this.ctx.resume().catch(() => {});
          }
        }

        createNoiseBuffer(duration: number) {
          if (!this.ctx) return null;
          const bufferSize = Math.floor(this.ctx.sampleRate * duration);
          const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
          return buffer;
        }

        playPowerOff() {
          this.init();
          if (!this.ctx) return;
          const now = this.ctx.currentTime;

          const buffer = this.createNoiseBuffer(0.45);
          if (buffer) {
            const noise = this.ctx.createBufferSource();
            noise.buffer = buffer;
            const noiseFilter = this.ctx.createBiquadFilter();
            noiseFilter.type = 'bandpass';
            noiseFilter.frequency.setValueAtTime(1200, now);
            noiseFilter.frequency.exponentialRampToValueAtTime(80, now + 0.4);

            const noiseGain = this.ctx.createGain();
            noiseGain.gain.setValueAtTime(0.25, now);
            noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

            noise.connect(noiseFilter);
            noiseFilter.connect(noiseGain);
            noiseGain.connect(this.ctx.destination);
            noise.start(now);
            noise.stop(now + 0.45);
          }

          const osc = this.ctx.createOscillator();
          const oscGain = this.ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(120, now);
          osc.frequency.exponentialRampToValueAtTime(30, now + 0.4);
          oscGain.gain.setValueAtTime(0.2, now);
          oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

          osc.connect(oscGain);
          oscGain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.45);
        }

        playDegaussWarp() {
          this.init();
          if (!this.ctx) return;
          const now = this.ctx.currentTime;

          const osc = this.ctx.createOscillator();
          const oscGain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(60, now);
          osc.frequency.linearRampToValueAtTime(180, now + 0.15);
          osc.frequency.exponentialRampToValueAtTime(20, now + 0.4);

          oscGain.gain.setValueAtTime(0.28, now);
          oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

          osc.connect(oscGain);
          oscGain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.42);
        }

        playBeamHum() {
          this.init();
          if (!this.ctx) return;
          const now = this.ctx.currentTime;

          const flyback = this.ctx.createOscillator();
          const flybackGain = this.ctx.createGain();
          flyback.type = 'sine';
          flyback.frequency.setValueAtTime(14000, now);
          flyback.frequency.exponentialRampToValueAtTime(120, now + 0.38);
          flybackGain.gain.setValueAtTime(0.15, now);
          flybackGain.gain.exponentialRampToValueAtTime(0.001, now + 0.38);

          flyback.connect(flybackGain);
          flybackGain.connect(this.ctx.destination);
          flyback.start(now);
          flyback.stop(now + 0.4);
        }
      }

      const audioEngine = new CRTTransitionAudio();

      function setupGlobalEngine() {
        const isAudioActive = document.body.dataset.audioTransitions === 'true';
        const crtOverlay = document.getElementById('crt-off-overlay');
        if (crtOverlay) {
          crtOverlay.className = 'fixed inset-0 pointer-events-none z-[100] opacity-0 flex items-center justify-center overflow-hidden';
        }

        const transitionLinks = document.querySelectorAll('a.post-transition-link, a[data-transition="true"]');
        transitionLinks.forEach((link) => {
          link.addEventListener('click', (e) => {
            const targetHref = link.getAttribute('href');
            if (!targetHref || targetHref.startsWith('#')) return;

            e.preventDefault();

            if (isAudioActive) {
              const audioVariants = ['power-off', 'degauss', 'beam-hum'];
              const chosen = audioVariants[Math.floor(Math.random() * audioVariants.length)];
              try {
                if (chosen === 'power-off') audioEngine.playPowerOff();
                else if (chosen === 'degauss') audioEngine.playDegaussWarp();
                else audioEngine.playBeamHum();
              } catch {}

              if (crtOverlay) {
                crtOverlay.className = `fixed inset-0 pointer-events-none z-[100] flex items-center justify-center overflow-hidden is-shutting-down mode-crt-${chosen}`;
              }
            } else {
              const silentModes = [
                'mode-scanline-sweep',
                'mode-static-burst-silent',
                'mode-horizontal-shutter',
                'mode-vertical-curtain',
                'mode-lens-defocus',
                'mode-analog-fade'
              ];
              const chosenMode = silentModes[Math.floor(Math.random() * silentModes.length)];
              if (crtOverlay) {
                crtOverlay.className = `fixed inset-0 pointer-events-none z-[100] flex items-center justify-center overflow-hidden is-shutting-down ${chosenMode}`;
              }
            }

            setTimeout(() => {
              navigate(targetHref);
            }, 420);
          });
        });
      }

      document.addEventListener('DOMContentLoaded', setupGlobalEngine);
      document.addEventListener('astro:page-load', setupGlobalEngine);

      document.addEventListener('contextmenu', async (e: MouseEvent) => {
        const target = e.target as HTMLElement | null;
        if (target && target.tagName === 'IMG' && !target.classList.contains('site-logo')) {
          e.preventDefault();
          const img = target as HTMLImageElement;
          
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          if (!ctx) return;

          const tempImg = new Image();
          tempImg.crossOrigin = 'anonymous';
          tempImg.src = img.src;

          await new Promise<void>((resolve) => {
            tempImg.onload = () => resolve();
          });

          canvas.width = tempImg.naturalWidth;
          canvas.height = tempImg.naturalHeight;

          ctx.drawImage(tempImg, 0, 0);

          const fontSize = Math.max(Math.round(canvas.width * 0.03), 16);
          const paddingX = Math.max(Math.round(canvas.width * 0.06), 35);
          const paddingY = Math.max(Math.round(canvas.height * 0.06), 35);

          ctx.font = `500 ${fontSize}px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace`;
          ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
          ctx.textAlign = 'end';
          ctx.fillText('darlalovly', canvas.width - paddingX, canvas.height - paddingY);

          canvas.toBlob((blob) => {
            if (!blob) return;
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = img.src.split('/').pop() || 'download.webp';
            a.click();
            URL.revokeObjectURL(url);
          }, 'image/webp');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Enforce black background on public layouts to prevent admin CSS bleed in production bundles */
  html,
  body.public-site {
    background-color: #0a0a0a !important;
    background: #0a0a0a !important;
    color: #e5e5e5 !important;
  }

  .animated-noise-overlay {
    background-image: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.4) 1px, transparent 1px), radial-gradient(circle at 20% 80%, rgba(255,255,255,0.3) 1px, transparent 1px);
    background-size: 6px 6px, 8px 8px;
    opacity: 0.18;
    mix-blend-mode: screen;
    animation: grain-motion 0.25s steps(4) infinite;
  }
  @keyframes grain-motion {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-3px, 2px); }
    50% { transform: translate(3px, -1px); }
    75% { transform: translate(-2px, -3px); }
    100% { transform: translate(2px, 1px); }
  }

  /* Global Content Flow, Typography Wrapping & Responsive Media */
  main,
  article,
  .prose,
  .post-body {
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
  }

  main img,
  article img,
  .prose img,
  .post-body img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  article p,
  .prose p,
  .post-body p {
    margin-bottom: 1.5rem;
    line-height: 1.75;
  }

  /* Floating image wrapping support for post articles */
  article img.align-left,
  .prose img.align-left,
  .post-body img.align-left {
    float: left;
    margin: 0.25rem 1.5rem 1.25rem 0;
    max-width: 50%;
  }

  article img.align-right,
  .prose img.align-right,
  .post-body img.align-right {
    float: right;
    margin: 0.25rem 0 1.25rem 1.5rem;
    max-width: 50%;
  }

  @media (max-width: 640px) {
    article img.align-left,
    article img.align-right,
    .prose img.align-left,
    .prose img.align-right,
    .post-body img.align-left,
    .post-body img.align-right {
      float: none;
      max-width: 100%;
      margin: 1.5rem auto;
      display: block;
    }
  }

  #crt-off-overlay.is-shutting-down {
    pointer-events: auto !important;
    opacity: 1;
    animation: crt-fade-black 0.46s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }
  .is-shutting-down .tv-scanlines {
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.75) 0px, rgba(0, 0, 0, 0.75) 1px, transparent 1px, transparent 3px);
  }

  /* Audio-backed index transitions */
  .mode-crt-power-off .crt-collapse-line {
    height: 100%;
    animation: crt-beam-collapse 0.44s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    box-shadow: 0 0 35px rgba(255, 255, 255, 1), 0 0 70px rgba(255, 255, 255, 0.9);
  }
  .mode-crt-degauss .degauss-warp-mesh {
    animation: degauss-warp 0.42s ease-out forwards;
    background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(0,0,0,0.85) 100%);
  }
  .mode-crt-beam-hum .crt-screen-flash {
    animation: flash-beam 0.4s ease-out forwards;
  }

  /* Silent transitions for subpages & posts */
  .mode-scanline-sweep .tv-scanlines {
    animation: scanline-sweep 0.4s ease-out forwards;
  }
  .mode-static-burst-silent .crt-static-burst {
    background-image: repeating-radial-gradient(circle at 50% 50%, rgba(255,255,255,0.4) 0, rgba(255,255,255,0.4) 1px, transparent 1px, transparent 100%);
    background-size: 4px 4px;
    animation: crt-static-fade 0.38s ease-out forwards;
  }
  .mode-horizontal-shutter {
    animation: shutter-horiz 0.42s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .mode-vertical-curtain {
    animation: curtain-vert 0.42s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .mode-lens-defocus {
    backdrop-filter: blur(12px) contrast(140%);
    animation: crt-fade-black 0.42s ease-out forwards;
  }
  .mode-analog-fade {
    animation: crt-fade-black 0.38s ease-in-out forwards;
  }

  /* Global Print Isolation */
  @media print {
    header,
    footer,
    nav,
    .animated-noise-overlay,
    #crt-off-overlay,
    .no-print {
      display: none !important;
    }

    body.public-site {
      background-color: #ffffff !important;
      background: #ffffff !important;
      color: #000000 !important;
    }
  }

  @keyframes crt-beam-collapse {
    0% { height: 100%; transform: scale(1, 1); background: transparent; }
    25% { height: 3px; transform: scale(1, 1); background: #ffffff; opacity: 1; }
    70% { height: 2px; transform: scale(0.04, 0.85); background: #ffffff; opacity: 1; }
    100% { height: 0px; transform: scale(0, 0); background: #ffffff; opacity: 0; }
  }
  @keyframes degauss-warp {
    0% { transform: scale(1) rotate(0deg); opacity: 0; }
    40% { transform: scale(1.05) rotate(1deg); opacity: 0.8; }
    100% { transform: scale(0.98) rotate(0deg); opacity: 1; }
  }
  @keyframes flash-beam {
    0% { opacity: 0; }
    30% { opacity: 0.8; }
    100% { opacity: 0; }
  }
  @keyframes scanline-sweep {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }
  @keyframes shutter-horiz {
    0% { clip-path: inset(0 0 0 0); }
    100% { clip-path: inset(0 50% 0 50%); }
  }
  @keyframes curtain-vert {
    0% { clip-path: inset(0 0 0 0); }
    100% { clip-path: inset(50% 0 50% 0); }
  }
  @keyframes crt-static-fade {
    0% { opacity: 0.8; }
    100% { opacity: 0; }
  }
  @keyframes crt-fade-black {
    0% { background-color: rgba(0, 0, 0, 0); }
    100% { background-color: rgba(0, 0, 0, 1); }
  }
</style>