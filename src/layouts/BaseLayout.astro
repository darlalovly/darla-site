---
// File: src/layouts/BaseLayout.astro

import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
  type?: 'website' | 'article';
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  author?: string;
  noindex?: boolean;
  enableAudioTransition?: boolean;
}

const { 
  title = "darlalovly", 
  description = "A personal digital garden of wanderings, unexpected detours, and visual archives.", 
  image = "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/branding/darlalovly-logo.webp",
  canonicalURL,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Darla',
  noindex = false,
  enableAudioTransition = false,
} = Astro.props;

const logoUrl = "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/branding/darlalovly-logo.webp";
---

<!doctype html>
<html lang="en">
  <head>
    <SEO 
      title={title}
      description={description}
      image={image}
      canonicalURL={canonicalURL}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      noindex={noindex}
    />
    <ClientRouter />
    <link rel="icon" type="image/webp" href={logoUrl} />
    <link rel="alternate" type="application/rss+xml" title="darlalovly" href="/rss.xml" />
  </head>
  <body 
    data-audio-transitions={enableAudioTransition ? "true" : "false"}
    class="public-site selection:bg-white selection:text-neutral-900 bg-neutral-950 text-neutral-100 min-h-screen flex flex-col justify-between items-center w-full overflow-x-hidden"
  >
    <!-- Fixed Analog Noise Static Overlay -->
    <div class="fixed inset-0 pointer-events-none z-50 animated-noise-overlay" aria-hidden="true"></div>

    <!-- Multi-Mode Analog & CRT Transition Overlay -->
    <div id="crt-off-overlay" class="fixed inset-0 pointer-events-none z-[100] opacity-0 flex items-center justify-center overflow-hidden" aria-hidden="true">
      <div class="crt-screen-flash absolute inset-0 bg-white opacity-0 pointer-events-none"></div>
      <div class="crt-static-burst absolute inset-0 pointer-events-none"></div>
      <div class="crt-collapse-line w-full pointer-events-none"></div>
      <div class="degauss-warp-mesh absolute inset-0 pointer-events-none"></div>
      <div class="tv-scanlines absolute inset-0 pointer-events-none"></div>
    </div>

    <!-- Modular Top Navigation Bar -->
    <Header logoUrl={logoUrl} />

    <!-- Centered Main Viewport Slot -->
    <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 pb-12 sm:pb-16 flex flex-col items-center">
      <slot />
    </main>

    <!-- Modular Footer -->
    <Footer siteName="darlalovly" />

    <script>
      import { navigate } from 'astro:transitions/client';

      class CRTTransitionAudio {
        ctx: AudioContext | null = null;

        init() {
          try {
            if (!this.ctx) {
              const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
              if (AudioCtx) this.ctx = new AudioCtx();
            }
            if (this.ctx && this.ctx.state === 'suspended') {
              this.ctx.resume().catch(() => {});
            }
          } catch {}
        }

        createNoiseBuffer(duration: number) {
          if (!this.ctx) return null;
          const bufferSize = Math.floor(this.ctx.sampleRate * duration);
          const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            data[i] = Math.random() * 2 - 1;
          }
          return buffer;
        }

        // 1. Classic CRT TV Turning Off (Flyback pitch drop + bandpass static burst)
        playTvTurnOff() {
          this.init();
          if (!this.ctx) return;
          const now = this.ctx.currentTime;

          const buffer = this.createNoiseBuffer(0.44);
          if (buffer) {
            const noise = this.ctx.createBufferSource();
            noise.buffer = buffer;
            const filter = this.ctx.createBiquadFilter();
            filter.type = 'bandpass';
            filter.frequency.setValueAtTime(1200, now);
            filter.frequency.exponentialRampToValueAtTime(80, now + 0.4);

            const gain = this.ctx.createGain();
            gain.gain.setValueAtTime(0.35, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

            noise.connect(filter);
            filter.connect(gain);
            gain.connect(this.ctx.destination);
            noise.start(now);
            noise.stop(now + 0.44);
          }

          const osc = this.ctx.createOscillator();
          const oscGain = this.ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(140, now);
          osc.frequency.exponentialRampToValueAtTime(30, now + 0.4);

          oscGain.gain.setValueAtTime(0.3, now);
          oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

          osc.connect(oscGain);
          oscGain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.44);
        }

        // 2. Electrical Buzz & Degauss Coil (Low magnetic resonance + spring twang)
        playElectricalBuzz() {
          this.init();
          if (!this.ctx) return;
          const now = this.ctx.currentTime;

          const osc = this.ctx.createOscillator();
          const oscGain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(60, now);
          osc.frequency.linearRampToValueAtTime(180, now + 0.15);
          osc.frequency.exponentialRampToValueAtTime(20, now + 0.4);

          oscGain.gain.setValueAtTime(0.35, now);
          oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

          osc.connect(oscGain);
          oscGain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.42);

          const buzz = this.ctx.createOscillator();
          const buzzGain = this.ctx.createGain();
          buzz.type = 'sawtooth';
          buzz.frequency.setValueAtTime(120, now);
          buzz.frequency.linearRampToValueAtTime(60, now + 0.4);

          buzzGain.gain.setValueAtTime(0.25, now);
          buzzGain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

          buzz.connect(buzzGain);
          buzzGain.connect(this.ctx.destination);
          buzz.start(now);
          buzz.stop(now + 0.42);
        }

        // 3. Mechanical Relay Clank & Cathode Hum
        playClankHum() {
          this.init();
          if (!this.ctx) return;
          const now = this.ctx.currentTime;

          const clank = this.ctx.createOscillator();
          const clankGain = this.ctx.createGain();
          clank.type = 'square';
          clank.frequency.setValueAtTime(320, now);
          clank.frequency.exponentialRampToValueAtTime(35, now + 0.08);

          clankGain.gain.setValueAtTime(0.5, now);
          clankGain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);

          clank.connect(clankGain);
          clankGain.connect(this.ctx.destination);
          clank.start(now);
          clank.stop(now + 0.1);

          const hum = this.ctx.createOscillator();
          const humGain = this.ctx.createGain();
          hum.type = 'sawtooth';
          hum.frequency.setValueAtTime(90, now + 0.02);
          hum.frequency.linearRampToValueAtTime(80, now + 0.38);

          humGain.gain.setValueAtTime(0.001, now);
          humGain.gain.setValueAtTime(0.35, now + 0.02);
          humGain.gain.exponentialRampToValueAtTime(0.001, now + 0.38);

          hum.connect(humGain);
          humGain.connect(this.ctx.destination);
          hum.start(now + 0.02);
          hum.stop(now + 0.4);
        }

        // 4. Authentic High-Frequency Flyback Beam Hum
        playBeamHum() {
          this.init();
          if (!this.ctx) return;
          const now = this.ctx.currentTime;

          const flyback = this.ctx.createOscillator();
          const flybackGain = this.ctx.createGain();
          flyback.type = 'sine';
          flyback.frequency.setValueAtTime(14000, now);
          flyback.frequency.exponentialRampToValueAtTime(120, now + 0.38);

          flybackGain.gain.setValueAtTime(0.2, now);
          flybackGain.gain.exponentialRampToValueAtTime(0.001, now + 0.38);

          flyback.connect(flybackGain);
          flybackGain.connect(this.ctx.destination);
          flyback.start(now);
          flyback.stop(now + 0.4);
        }
      }

      const audioEngine = new CRTTransitionAudio();
      let isNavigating = false;
      let lastVariantIndex = -1;

      const warmAudioContext = () => {
        audioEngine.init();
      };
      window.addEventListener('pointerdown', warmAudioContext, { passive: true });
      window.addEventListener('touchstart', warmAudioContext, { passive: true });
      window.addEventListener('mousedown', warmAudioContext, { passive: true });

      function resetOverlay() {
        isNavigating = false;
        const crtOverlay = document.getElementById('crt-off-overlay');
        if (crtOverlay) {
          crtOverlay.className = 'fixed inset-0 pointer-events-none z-[100] opacity-0 flex items-center justify-center overflow-hidden';
        }
      }

      function handleTransitionClick(e: MouseEvent) {
        const link = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('a.post-transition-link, a[data-transition="true"]');
        if (!link) return;

        const targetHref = link.getAttribute('href');
        if (!targetHref || targetHref.startsWith('#') || targetHref.startsWith('javascript:')) return;
        if (isNavigating) return;

        const isFromIndex = document.body.dataset.audioTransitions === 'true' || 
                            window.location.pathname === '/' || 
                            window.location.pathname === '';

        if (!isFromIndex) return;

        e.preventDefault();
        isNavigating = true;

        audioEngine.init();
        const crtOverlay = document.getElementById('crt-off-overlay');

        const transitionVariants = [
          { name: 'power-off', play: () => audioEngine.playTvTurnOff(), delay: 440 },
          { name: 'degauss', play: () => audioEngine.playElectricalBuzz(), delay: 420 },
          { name: 'beam-hum', play: () => audioEngine.playClankHum(), delay: 400 },
          { name: 'beam-hum', play: () => audioEngine.playBeamHum(), delay: 400 }
        ];

        let chosenIndex = Math.floor(Math.random() * transitionVariants.length);
        if (chosenIndex === lastVariantIndex) {
          chosenIndex = (chosenIndex + 1) % transitionVariants.length;
        }
        lastVariantIndex = chosenIndex;

        const selected = transitionVariants[chosenIndex];

        try {
          selected.play();
        } catch {}

        if (crtOverlay) {
          crtOverlay.className = `fixed inset-0 z-[100] flex items-center justify-center overflow-hidden is-shutting-down mode-crt-${selected.name}`;
        }

        setTimeout(() => {
          navigate(targetHref);
        }, selected.delay);
      }

      function bindRouter() {
        document.removeEventListener('click', handleTransitionClick);
        document.addEventListener('click', handleTransitionClick);
      }

      document.addEventListener('astro:page-load', () => {
        resetOverlay();
        bindRouter();
      });

      document.addEventListener('astro:after-swap', resetOverlay);

      document.addEventListener('contextmenu', async (e: MouseEvent) => {
        const target = e.target as HTMLElement | null;
        if (target && target.tagName === 'IMG' && !target.classList.contains('site-logo')) {
          e.preventDefault();
          const img = target as HTMLImageElement;
          
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          if (!ctx) return;

          const tempImg = new Image();
          tempImg.crossOrigin = 'anonymous';
          tempImg.src = img.src;

          await new Promise<void>((resolve) => {
            tempImg.onload = () => resolve();
          });

          canvas.width = tempImg.naturalWidth;
          canvas.height = tempImg.naturalHeight;

          ctx.drawImage(tempImg, 0, 0);

          const fontSize = Math.max(Math.round(canvas.width * 0.03), 16);
          const paddingX = Math.max(Math.round(canvas.width * 0.06), 35);
          const paddingY = Math.max(Math.round(canvas.height * 0.06), 35);

          ctx.font = `500 ${fontSize}px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace`;
          ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
          ctx.textAlign = 'end';
          ctx.fillText('darlalovly', canvas.width - paddingX, canvas.height - paddingY);

          canvas.toBlob((blob) => {
            if (!blob) return;
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = img.src.split('/').pop() || 'download.webp';
            a.click();
            URL.revokeObjectURL(url);
          }, 'image/webp');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Root Viewport Hard-Centering & Boundary Locks */
  html,
  body.public-site {
    overflow-x: hidden !important;
    max-width: 100% !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background-color: #0a0a0a !important;
    background: #0a0a0a !important;
    color: #e5e5e5 !important;
  }

  main {
    width: 100% !important;
    max-width: 1024px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    box-sizing: border-box !important;
  }

  .animated-noise-overlay {
    background-image: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.4) 1px, transparent 1px), radial-gradient(circle at 20% 80%, rgba(255,255,255,0.3) 1px, transparent 1px);
    background-size: 6px 6px, 8px 8px;
    opacity: 0.18;
    mix-blend-mode: screen;
    animation: grain-motion 0.25s steps(4) infinite;
  }
  @keyframes grain-motion {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-3px, 2px); }
    50% { transform: translate(3px, -1px); }
    75% { transform: translate(-2px, -3px); }
    100% { transform: translate(2px, 1px); }
  }

  main,
  article,
  .prose,
  .post-body {
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
  }

  main img,
  article img,
  .prose img,
  .post-body img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  article p,
  .prose p,
  .post-body p {
    margin-bottom: 1.5rem;
    line-height: 1.75;
  }

  article img.align-left,
  .prose img.align-left,
  .post-body img.align-left {
    float: left;
    margin: 0.25rem 1.5rem 1.25rem 0;
    max-width: 50%;
  }

  article img.align-right,
  .prose img.align-right,
  .post-body img.align-right {
    float: right;
    margin: 0.25rem 0 1.25rem 1.5rem;
    max-width: 50%;
  }

  @media (max-width: 640px) {
    article img.align-left,
    article img.align-right,
    .prose img.align-left,
    .prose img.align-right,
    .post-body img.align-left,
    .post-body img.align-right {
      float: none;
      max-width: 100%;
      margin: 1.5rem auto;
      display: block;
    }
  }

  /* Full Screen CRT Transitions */
  #crt-off-overlay {
    background: transparent;
    transition: opacity 0.08s ease;
  }

  #crt-off-overlay.is-shutting-down {
    pointer-events: auto !important;
    opacity: 1 !important;
    animation: crt-fade-black 0.46s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  .is-shutting-down .tv-scanlines {
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.75) 0px, rgba(0, 0, 0, 0.75) 1px, transparent 1px, transparent 3px);
  }

  /* Audio-backed index transitions */
  .mode-crt-power-off .crt-collapse-line {
    height: 100%;
    animation: crt-beam-collapse 0.44s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    box-shadow: 0 0 35px rgba(255, 255, 255, 1), 0 0 70px rgba(255, 255, 255, 0.9);
  }

  .mode-crt-degauss .degauss-warp-mesh {
    animation: degauss-warp 0.42s ease-out forwards;
    background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(0,0,0,0.85) 100%);
  }

  .mode-crt-beam-hum .crt-screen-flash {
    animation: flash-beam 0.4s ease-out forwards;
  }

  @media print {
    header,
    footer,
    nav,
    .animated-noise-overlay,
    #crt-off-overlay,
    .no-print {
      display: none !important;
    }

    body.public-site {
      background-color: #ffffff !important;
      background: #ffffff !important;
      color: #000000 !important;
    }
  }

  @keyframes crt-beam-collapse {
    0% { height: 100%; transform: scale(1, 1); background: transparent; }
    25% { height: 3px; transform: scale(1, 1); background: #ffffff; opacity: 1; }
    70% { height: 2px; transform: scale(0.04, 0.85); background: #ffffff; opacity: 1; }
    100% { height: 0px; transform: scale(0, 0); background: #ffffff; opacity: 0; }
  }

  @keyframes degauss-warp {
    0% { transform: scale(1) rotate(0deg); opacity: 0; }
    40% { transform: scale(1.05) rotate(1deg); opacity: 0.8; }
    100% { transform: scale(0.98) rotate(0deg); opacity: 1; }
  }

  @keyframes flash-beam {
    0% { opacity: 0; }
    30% { opacity: 0.8; }
    100% { opacity: 0; }
  }

  @keyframes crt-fade-black {
    0% { background-color: rgba(0, 0, 0, 0); }
    100% { background-color: rgba(0, 0, 0, 1); }
  }
</style>