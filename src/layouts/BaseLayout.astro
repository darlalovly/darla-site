---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "darlalovly" } = Astro.props;
const logoUrl = "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/darlalovly-logo.webp";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href={logoUrl} />
    <title>{title}</title>
  </head>
  <body class="bg-white text-neutral-800 antialiased min-h-screen flex flex-col">
    <header class="w-full border-b border-neutral-100 py-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
        <a href="/" class="hover:opacity-75 transition-opacity">
          <img src={logoUrl} alt="darlalovly" class="h-10 sm:h-12 w-auto object-contain" />
        </a>
      </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <slot />
    </main>

    <script>
      document.addEventListener('contextmenu', async (e: MouseEvent) => {
        const target = e.target as HTMLElement | null;
        if (target && target.tagName === 'IMG') {
          e.preventDefault();
          const img = target as HTMLImageElement;
          
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          if (!ctx) return;

          const tempImg = new Image();
          tempImg.crossOrigin = 'anonymous';
          tempImg.src = img.src;

          await new Promise<void>((resolve) => {
            tempImg.onload = () => resolve();
          });

          canvas.width = tempImg.naturalWidth;
          canvas.height = tempImg.naturalHeight;

          ctx.drawImage(tempImg, 0, 0);

          const fontSize = Math.max(Math.round(canvas.width * 0.03), 16);
          const paddingX = Math.max(Math.round(canvas.width * 0.06), 35);
          const paddingY = Math.max(Math.round(canvas.height * 0.06), 35);

          ctx.font = `500 ${fontSize}px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace`;
          ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
          ctx.textAlign = 'end';
          ctx.fillText('darlalovly', canvas.width - paddingX, canvas.height - paddingY);

          canvas.toBlob((blob) => {
            if (!blob) return;
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = img.src.split('/').pop() || 'download.webp';
            a.click();
            URL.revokeObjectURL(url);
          }, 'image/webp');
        }
      });
    </script>
  </body>
</html>