---
// File: src/layouts/AdminLayout.astro

import '../styles/admin.css';

interface Props {
  title?: string;
}

const { title = "Dashboard ‹ darlalovly Studio" } = Astro.props;
const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === '/admin' && (currentPath === '/admin' || currentPath === '/admin/')) return true;
  if (path !== '/admin' && currentPath.startsWith(path)) return true;
  return false;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/webp" href="https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/branding/darlalovly-logo.webp" />
  </head>
  <body>
    <!-- Top Admin Bar -->
    <header class="admin-topbar">
      <div class="topbar-left">
        <a href="/admin" class="topbar-brand">
          <span class="brand-avatar">D</span>
          <span class="brand-name">darlalovly studio</span>
        </a>
        <a href="/" target="_blank" rel="noopener noreferrer" class="topbar-site-link">View Site ↗</a>
      </div>
      <div class="topbar-right">
        <span class="topbar-user">Signed in as <strong>Darla</strong></span>
      </div>
    </header>

    <!-- Admin Body Container -->
    <div class="admin-layout-container">
      <!-- Left Column Menu -->
      <aside class="admin-sidebar" aria-label="Main Studio Navigation">
        <nav class="sidebar-menu">
          
          <div class="menu-section">
            <a href="/admin" class={`menu-item ${isActive('/admin') && currentPath !== '/admin/new' && currentPath !== '/admin/recipes/new' && currentPath !== '/admin/messages' && currentPath !== '/admin/gallery' ? 'is-active' : ''}`}>
              <span class="menu-icon">✦</span>
              <span class="menu-label">Dashboard</span>
            </a>
            <a href="/admin/messages" class={`menu-item ${isActive('/admin/messages') ? 'is-active' : ''}`}>
              <span class="menu-icon">✉</span>
              <span class="menu-label">Inbox</span>
            </a>
          </div>

          <div class="menu-section">
            <div class="menu-heading">Entries</div>
            <a href="/admin" class={`submenu-item ${isActive('/admin') && currentPath !== '/admin/new' && currentPath !== '/admin/recipes/new' && currentPath !== '/admin/messages' && currentPath !== '/admin/gallery' ? 'is-active' : ''}`}>
              All Entries
            </a>
            <a href="/admin/new" class={`submenu-item ${isActive('/admin/new') ? 'is-active' : ''}`}>
              Add New Post
            </a>
            <a href="/admin/recipes/new" class={`submenu-item ${isActive('/admin/recipes/new') ? 'is-active' : ''}`}>
              Add New Recipe
            </a>
          </div>

          <div class="menu-section">
            <div class="menu-heading">Media</div>
            <a href="/admin/gallery" class={`submenu-item ${isActive('/admin/gallery') ? 'is-active' : ''}`}>
              Library
            </a>
          </div>

          <div class="menu-section menu-section-bottom">
            <a href="/" target="_blank" rel="noopener noreferrer" class="menu-item site-external-link">
              <span class="menu-icon">↗</span>
              <span class="menu-label">View Live Garden</span>
            </a>
          </div>

        </nav>
      </aside>

      <!-- Main Admin Content Area -->
      <main class="admin-main-content">
        <slot />
      </main>
    </div>
  </body>
</html>