---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Darla Lovly — Field Notes & Sanctuary",
  description = "Nomadic field notes, sensory memories, and personal sanctuary." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icons/logo-black.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>

    <!-- Sniffcult Master Fixed Header -->
    <header class="col-topnav">
      <a href="/" class="col-topnav-brand">
        <img src="https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/darlalovly-logo.webp" alt="Darla Lovly" />
      </a>
      
      <nav class="col-nav-desktop">
        <ul class="col-nav-list">
          <li><a href="/field_notes">Field Notes</a></li>
          <li><a href="/books">Library</a></li>
          <li><a href="/recipes">Recipes</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>
    </header>

    <!-- Main Content Container with Top Padding for Fixed Header -->
    <main class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>

  </body>
</html>