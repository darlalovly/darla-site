---
// File: src/components/SEO.astro

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL | string;
  type?: 'website' | 'article';
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
  author?: string;
  noindex?: boolean;
}

const {
  title = 'darlalovly — Digital Garden & Visual Archives',
  description = 'A personal digital garden of wanderings, unexpected detours, and visual archives.',
  image,
  canonicalURL = Astro.url,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Darla',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/+$/, '') : Astro.url.origin;
const formattedCanonical = typeof canonicalURL === 'string' ? canonicalURL : canonicalURL.href;

const cleanPath = Astro.url.pathname.replace(/^\/|\/$/g, '');
const hasCustomImage = image && !image.includes('darlalovly-logo') && !image.includes('og-default');

let ogImage: string;
if (cleanPath.startsWith('posts/') || cleanPath.startsWith('recipes/')) {
  ogImage = `${siteUrl}/og/${cleanPath}.png`;
} else if (hasCustomImage) {
  const str = String(image);
  ogImage = str.startsWith('http://') || str.startsWith('https://')
    ? str
    : `${siteUrl}${str.startsWith('/') ? '' : '/'}${str}`;
} else {
  ogImage = `${siteUrl}/og/default.png`;
}

const pubDateISO = publishedTime ? new Date(publishedTime).toISOString() : undefined;
const modDateISO = modifiedTime ? new Date(modifiedTime).toISOString() : pubDateISO;

const schemaOrg = type === 'article'
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": formattedCanonical,
      },
      "headline": title,
      "description": description,
      "image": [ogImage],
      "datePublished": pubDateISO,
      "dateModified": modDateISO,
      "author": {
        "@type": "Person",
        "name": author,
      },
      "publisher": {
        "@type": "Organization",
        "name": "darlalovly",
        "logo": {
          "@type": "ImageObject",
          "url": "https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/branding/darlalovly-logo.webp",
        },
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "darlalovly",
      "url": siteUrl,
      "description": description,
    };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/webp" href="https://pub-23c94031ab954f6cb120959a02ecef04.r2.dev/branding/darlalovly-logo.webp" />
<link rel="canonical" href={formattedCanonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="darlalovly RSS Feed" href="/rss.xml" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="darlalovly" />
<meta property="og:url" content={formattedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{pubDateISO && <meta property="article:published_time" content={pubDateISO} />}
{modDateISO && <meta property="article:modified_time" content={modDateISO} />}
{type === 'article' && <meta property="article:author" content={author} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={formattedCanonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} is:inline />